#if defined(DATA_A_Q6_K)
// Q6_K byte-packed A: 8 int32 per BK=32 tile (4 6-bit-minus-32 values per
// int32), with two per-16 scales.
void block_a_to_shmem(const uint buf_ib, const uint ib, const uint iqs) {
    const uint ib_k = ib / 8;
    const uint g = ib % 8;
    const uint iqs_k = g * 8 + iqs;

    const uint ql_idx = (iqs_k / 32) * 16 + iqs_k % 16;
    const uint ql_shift = ((iqs_k % 32) / 16) * 4;
    const uint qh_idx = (iqs_k / 32) * 8 + iqs;
    const uint qh_shift = ((iqs_k % 32) / 8) * 2;

    const i8vec2 vals00 = (unpack8(int32_t((data_a[ib_k].ql[ql_idx * 2    ] >> ql_shift) & uint16_t(0x0F0F))).xy |
                          unpack8(int32_t(((data_a[ib_k].qh[qh_idx * 2    ] >> qh_shift) & uint16_t(0x0303)) << 4)).xy) - int8_t(32);
    const i8vec2 vals01 = (unpack8(int32_t((data_a[ib_k].ql[ql_idx * 2 + 1] >> ql_shift) & uint16_t(0x0F0F))).xy |
                          unpack8(int32_t(((data_a[ib_k].qh[qh_idx * 2 + 1] >> qh_shift) & uint16_t(0x0303)) << 4)).xy) - int8_t(32);

    buf_a[buf_ib].qs[iqs] = pack32(i8vec4(vals00.x, vals00.y, vals01.x, vals01.y));

    if (iqs == 0) {
        const int s0 = int(data_a[ib_k].scales[2u * g]);
        const int s1 = int(data_a[ib_k].scales[2u * g + 1u]);
        buf_a[buf_ib].dm = FLOAT_TYPE_VEC2(float(data_a[ib_k].d) * float(s0), float(data_a[ib_k].d) * float(s1));
    }
}

void block_a_to_registers(const uint reg_ib, const uint buf_ib) {
    cache_a[reg_ib].dm = buf_a[buf_ib].dm;

    [[unroll]] for (uint iqs = 0; iqs < 8; iqs++) {
        cache_a[reg_ib].qs[iqs] = buf_a[buf_ib].qs[iqs];
    }
}

ACC_TYPE mmq_dot_product(const uint ib_a) {
    float result = 0.0;
    int32_t q_sum = 0;

    [[unroll]] for (uint iqs = 0; iqs < 4; iqs++) {
        q_sum += dotPacked4x8EXT(cache_a[ib_a].qs[iqs], cache_b.qs[iqs]);
    }
    result += float(cache_a[ib_a].dm.x) * float(q_sum);
    q_sum = 0;

    [[unroll]] for (uint iqs = 4; iqs < 8; iqs++) {
        q_sum += dotPacked4x8EXT(cache_a[ib_a].qs[iqs], cache_b.qs[iqs]);
    }
    result += float(cache_a[ib_a].dm.y) * float(q_sum);

    return ACC_TYPE(float(cache_b.ds.x) * result);
}
#endif

#if !defined(DATA_A_Q2_K) && !defined(DATA_A_Q3_K) && !defined(DATA_A_Q4_K) && !defined(DATA_A_Q5_K) && !defined(DATA_A_Q6_K)
// Generic byte-packed A staging: 4 int8 values per int32 (8 int32 per BK=32
// tile), with either a single scale (QUANT_AUXF == 1) or a per-16 scale/min
// pair (QUANT_AUXF == 2).
void block_a_to_shmem(const uint buf_ib, const uint ib, const uint iqs) {
#if QUANT_AUXF == 1
    if (iqs == 0) {
        buf_a[buf_ib].dm = get_d(ib);
    }
#else
    if (iqs == 0) {
        buf_a[buf_ib].dm = get_dm(ib);
    }
#endif
#if QUANT_R == 1
    buf_a[buf_ib].qs[iqs] = repack(ib, iqs);
#else
    const i32vec2 vals = repack(ib, iqs);
    buf_a[buf_ib].qs[iqs    ] = vals.x;
    buf_a[buf_ib].qs[iqs + 4] = vals.y;
#endif
}

void block_a_to_registers(const uint reg_ib, const uint buf_ib) {
    cache_a[reg_ib].dm = buf_a[buf_ib].dm;

    [[unroll]] for (uint iqs = 0; iqs < A_QS_PER_TILE; iqs++) {
        cache_a[reg_ib].qs[iqs] = buf_a[buf_ib].qs[iqs];
    }
}

ACC_TYPE mmq_dot_product(const uint ib_a) {
#if defined(LEGACY_K_OFFSET)
    int32_t q_sum = 0;
    [[unroll]] for (uint idx_k = 0; idx_k < BK / 4; idx_k++) {
        q_sum += dotPacked4x8EXT(cache_a[ib_a].qs[idx_k], cache_b.qs[idx_k]);
    }

    const FLOAT_TYPE_VEC2 dm = cache_a[ib_a].dm;
    const FLOAT_TYPE_VEC2 ds = cache_b.ds;
    return ACC_TYPE(float(ds.x) * float(dm.x) * float(q_sum) - float(dm.y) * float(ds.y));
#elif defined(IQK_PER16_SCALES)
    int32_t q_sum1 = 0;
    int32_t q_sum2 = 0;
    [[unroll]] for (uint idx_k = 0; idx_k < BK / 8; idx_k++) {
        q_sum1 += dotPacked4x8EXT(cache_a[ib_a].qs[idx_k], cache_b.qs[idx_k]);
        q_sum2 += dotPacked4x8EXT(cache_a[ib_a].qs[idx_k + BK / 8], cache_b.qs[idx_k + BK / 8]);
    }

    const FLOAT_TYPE_VEC2 dm = cache_a[ib_a].dm;
    const FLOAT_TYPE_VEC2 ds = cache_b.ds;
    return ACC_TYPE(dm.x * (float(q_sum1) * ds.x) + dm.y * (float(q_sum2) * ds.x));
#else
    int32_t q_sum = 0;
    [[unroll]] for (uint idx_k = 0; idx_k < BK / 4; idx_k++) {
        q_sum += dotPacked4x8EXT(cache_a[ib_a].qs[idx_k], cache_b.qs[idx_k]);
    }

    return mul_q8_1(q_sum, cache_a[ib_a].dm, cache_b.ds);
#endif
}
#endif // !DATA_A_Q2_K && !DATA_A_Q3_K && !DATA_A_Q4_K
