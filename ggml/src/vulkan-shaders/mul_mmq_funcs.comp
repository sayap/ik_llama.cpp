#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require

#include "types.comp"

// Each iqs value maps to a 32-bit integer

#if defined(DATA_A_Q4_0)
i32vec2 repack(uint ib, uint iqs) {
    // Use 2-byte loads since a q4_0 block (18 bytes) is not divisible by 4
    const u16vec2 quants = u16vec2(data_a[ib].qs[iqs * 2    ],
                                   data_a[ib].qs[iqs * 2 + 1]);
    const uint32_t vui = pack32(quants);
    return i32vec2( vui       & 0x0F0F0F0F,
                   (vui >> 4) & 0x0F0F0F0F);
}

ACC_TYPE mul_q8_1(int32_t q_sum, float da, vec2 dsb) {
    return ACC_TYPE(da * (float(q_sum) * dsb.x - 8.0f * dsb.y));
}
#endif

#if defined(DATA_A_Q4_1)
i32vec2 repack(uint ib, uint iqs) {
    // Use 4-byte loads since a q4_1 block (20 bytes) is divisible by 4
    const uint32_t vui = data_a_packed32[ib].qs[iqs];
    return i32vec2( vui       & 0x0F0F0F0F,
                   (vui >> 4) & 0x0F0F0F0F);
}

ACC_TYPE mul_q8_1(int32_t q_sum, vec2 dma, vec2 dsb) {
    return ACC_TYPE(float(q_sum) * dma.x * dsb.x + dma.y * dsb.y);
}
#endif

#if defined(DATA_A_Q5_0)
i32vec2 repack(uint ib, uint iqs) {
    // Use 2-byte loads since a q5_0 block (22 bytes) is not divisible by 4
    const u16vec2 quants = u16vec2(data_a[ib].qs[iqs * 2    ],
                                   data_a[ib].qs[iqs * 2 + 1]);
    const uint32_t vui = pack32(quants);
    const int32_t qh = int32_t((uint32_t(data_a[ib].qh[1]) << 16 | data_a[ib].qh[0]) >> (4 * iqs));
    const int32_t v0 = int32_t(vui & 0x0F0F0F0F)
                     | ((qh & 0xF) * 0x02040810) & 0x10101010; // (0,1,2,3) -> (4,12,20,28)

    const int32_t v1 = int32_t((vui >> 4) & 0x0F0F0F0F)
                     | (((qh >> 16) & 0xF) * 0x02040810) & 0x10101010; // (16,17,18,19) -> (4,12,20,28)

    return i32vec2(v0, v1);
}

ACC_TYPE mul_q8_1(int32_t q_sum, float da, vec2 dsb) {
    return ACC_TYPE(da * (float(q_sum) * dsb.x - 16.0f * dsb.y));
}
#endif

#if defined(DATA_A_Q5_1)
i32vec2 repack(uint ib, uint iqs) {
    // Use 4-byte loads since a q5_1 block (24 bytes) is divisible by 4
    const uint32_t vui = data_a_packed32[ib].qs[iqs];
    const int32_t qh = int32_t(data_a_packed32[ib].qh >> (4 * iqs));
    const int32_t v0 = int32_t(vui & 0x0F0F0F0F)
                     | ((qh & 0xF) * 0x02040810) & 0x10101010; // (0,1,2,3) -> (4,12,20,28)

    const int32_t v1 = int32_t((vui >> 4) & 0x0F0F0F0F)
                     | (((qh >> 16) & 0xF) * 0x02040810) & 0x10101010; // (16,17,18,19) -> (4,12,20,28)

    return i32vec2(v0, v1);
}

ACC_TYPE mul_q8_1(int32_t q_sum, vec2 dma, vec2 dsb) {
    return ACC_TYPE(float(q_sum) * dma.x * dsb.x + dma.y * dsb.y);
}
#endif

#if defined(DATA_A_Q8_0)
int32_t repack(uint ib, uint iqs) {
    // Use 2-byte loads since a q8_0 block (34 bytes) is not divisible by 4
    return pack32(i16vec2(data_a[ib].qs[iqs * 2    ],
                          data_a[ib].qs[iqs * 2 + 1]));
}

ACC_TYPE mul_q8_1(int32_t q_sum, float da, vec2 dsb) {
    return ACC_TYPE(float(q_sum) * da * dsb.x);
}
#endif

#if defined(DATA_A_Q4_0) || defined(DATA_A_Q5_0) || defined(DATA_A_Q8_0) || defined(DATA_A_IQ1_S) || defined(DATA_A_IQ2_XXS) || defined(DATA_A_IQ2_XS) || defined(DATA_A_IQ2_S) || defined(DATA_A_IQ3_XXS) || defined(DATA_A_IQ3_S) || defined(DATA_A_IQ4_XS) || defined(DATA_A_IQ4_NL)
FLOAT_TYPE get_d(uint ib) {
    return FLOAT_TYPE(data_a[ib].d);
}
#endif

#if defined(DATA_A_Q4_1) || defined(DATA_A_Q5_1)
FLOAT_TYPE_VEC2 get_dm(uint ib) {
    return FLOAT_TYPE_VEC2(data_a_packed32[ib].dm);
}
#endif

#if defined(DATA_A_IQ4_KS)
// IQ4_KS byte-addressed mmq decode.
//
// The weights are byte-addressed with a 4-byte fp32 row header followed by
// 136-byte 256-element blocks (8 scale bytes + 128 quantized bytes). The mmq
// tile (BK=32) maps 1:1 onto a 32-element group, which has a single scale
// (folded into dl) and 16 quantized bytes (8 nibble pairs = 8 elements per
// repack). p.stride_a is the K dimension in elements, so
// groups_per_row = p.stride_a / BK.

#include "iq4k_byte_tables.comp"

shared uint iq4k_byte_shmem[2][256];

#define NEEDS_INIT_IQ_SHMEM
void init_iq_shmem(uvec3 wgsize) {
    for (uint idx = gl_LocalInvocationIndex.x; idx < 128; idx += wgsize.x) {
        const uint e0  = iq4k_values_byte_0[idx];
        const uint e16 = iq4k_values_byte_16[idx];
        iq4k_byte_shmem[0][2*idx]     = e0 & 0xffffu;
        iq4k_byte_shmem[0][2*idx + 1] = e0 >> 16;
        iq4k_byte_shmem[1][2*idx]     = e16 & 0xffffu;
        iq4k_byte_shmem[1][2*idx + 1] = e16 >> 16;
    }
    barrier();
}

uint iqk_load_u32(uint off) {
    return uint(data_a[off]) | (uint(data_a[off + 1]) << 8) | (uint(data_a[off + 2]) << 16) | (uint(data_a[off + 3]) << 24);
}

FLOAT_TYPE get_d(uint ib) {
    const uint groups_per_row = p.stride_a / BK;
    const uint blocks_per_row = groups_per_row / 8u;
    const uint row    = ib / groups_per_row;
    const uint group  = ib % groups_per_row;
    const uint block  = group / 8u;
    const uint g_in_b = group % 8u;

    const uint row_byte   = row * (4u + blocks_per_row * 136u);
    const uint block_byte = row_byte + 4u + block * 136u;

    const float d  = uintBitsToFloat(iqk_load_u32(row_byte));
    const uint  sc = data_a[block_byte + g_in_b];
    return FLOAT_TYPE(d * (float(sc & 254u) - 127.0f));
}

i32vec2 repack(uint ib, uint iqs) {
    const uint groups_per_row = p.stride_a / BK;
    const uint blocks_per_row = groups_per_row / 8u;
    const uint row    = ib / groups_per_row;
    const uint group  = ib % groups_per_row;
    const uint block  = group / 8u;
    const uint g_in_b = group % 8u;

    const uint row_byte   = row * (4u + blocks_per_row * 136u);
    const uint block_byte = row_byte + 4u + block * 136u;

    const uint sc    = data_a[block_byte + g_in_b];
    const uint v_sel = (sc & 1u) != 0u ? 1u : 0u;

    const uint w = iqk_load_u32(block_byte + 8u + 16u * g_in_b + 4u * iqs);

    int packed_lo = 0;
    int packed_hi = 0;
    [[unroll]] for (uint k = 0; k < 4; ++k) {
        const uint q     = (w >> (8u * k)) & 0xffu;
        const uint entry = iq4k_byte_shmem[v_sel][q];
        packed_lo |= int(entry & 0xffu) << (8 * k);
        packed_hi |= int((entry >> 8) & 0xffu) << (8 * k);
    }
    return i32vec2(packed_lo, packed_hi);
}

ACC_TYPE mul_q8_1(int32_t q_sum, float da, vec2 dsb) {
    return ACC_TYPE(da * (float(q_sum) * dsb.x));
}
#endif
