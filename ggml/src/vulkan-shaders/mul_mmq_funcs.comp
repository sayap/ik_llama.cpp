// Byte-addressed IQK/KT decode helpers and lookup tables. The mmq tile (BK=32)
// maps onto one 32-element group of a 256-element block, so each repack covers
// 8 elements (two packed-int8 uint32s). iqk_tables.comp provides the value
// tables plus iqk_load_u16/u32 (unaligned-safe byte loads) and the KT-family
// hash decode (iqk_hash_values_packed, used with IQK_USE_DOT4).
#if defined(DATA_A_IQ2_K)   || defined(DATA_A_IQ3_K)   || defined(DATA_A_IQ4_K)   || \
    defined(DATA_A_IQ5_K)   || defined(DATA_A_IQ6_K)   || \
    defined(DATA_A_IQ2_KS) || defined(DATA_A_IQ3_KS) || defined(DATA_A_IQ4_KS) || \
    defined(DATA_A_IQ4_KSS) || defined(DATA_A_IQ5_KS) || defined(DATA_A_IQ2_KL) || \
    defined(DATA_A_IQ1_KT) || defined(DATA_A_IQ2_KT) || defined(DATA_A_IQ3_KT) || \
    defined(DATA_A_IQ4_KT)
#ifndef IQK_TABLES_INCLUDED
#define IQK_TABLES_INCLUDED
#define IQK_TABLES_NO_BINDING
#define IQK_USE_DOT4
#include "iqk_tables.comp"
#endif
#endif

#if defined(DATA_A_IQ2_K) || defined(DATA_A_IQ2_KS)
#include "iq2k_table.comp"
#endif

// Each iqs value maps to a 32-bit integer

#if defined(DATA_A_Q4_0)
i32vec2 repack(uint ib, uint iqs) {
    // Use 2-byte loads since a q4_0 block (18 bytes) is not divisible by 4
    const u16vec2 quants = u16vec2(data_a[ib].qs[iqs * 2    ],
                                   data_a[ib].qs[iqs * 2 + 1]);
    const uint32_t vui = pack32(quants);
    return i32vec2( vui       & 0x0F0F0F0F,
                   (vui >> 4) & 0x0F0F0F0F);
}

ACC_TYPE mul_q8_1(int32_t q_sum, float da, vec2 dsb) {
    return ACC_TYPE(da * (float(q_sum) * dsb.x - 8.0f * dsb.y));
}
#endif

#if defined(DATA_A_Q4_1)
i32vec2 repack(uint ib, uint iqs) {
    // Use 4-byte loads since a q4_1 block (20 bytes) is divisible by 4
    const uint32_t vui = data_a_packed32[ib].qs[iqs];
    return i32vec2( vui       & 0x0F0F0F0F,
                   (vui >> 4) & 0x0F0F0F0F);
}

ACC_TYPE mul_q8_1(int32_t q_sum, vec2 dma, vec2 dsb) {
    return ACC_TYPE(float(q_sum) * dma.x * dsb.x + dma.y * dsb.y);
}
#endif

#if defined(DATA_A_Q5_0)
i32vec2 repack(uint ib, uint iqs) {
    // Use 2-byte loads since a q5_0 block (22 bytes) is not divisible by 4
    const u16vec2 quants = u16vec2(data_a[ib].qs[iqs * 2    ],
                                   data_a[ib].qs[iqs * 2 + 1]);
    const uint32_t vui = pack32(quants);
    const int32_t qh = int32_t((uint32_t(data_a[ib].qh[1]) << 16 | data_a[ib].qh[0]) >> (4 * iqs));
    const int32_t v0 = int32_t(vui & 0x0F0F0F0F)
                     | ((qh & 0xF) * 0x02040810) & 0x10101010; // (0,1,2,3) -> (4,12,20,28)

    const int32_t v1 = int32_t((vui >> 4) & 0x0F0F0F0F)
                     | (((qh >> 16) & 0xF) * 0x02040810) & 0x10101010; // (16,17,18,19) -> (4,12,20,28)

    return i32vec2(v0, v1);
}

ACC_TYPE mul_q8_1(int32_t q_sum, float da, vec2 dsb) {
    return ACC_TYPE(da * (float(q_sum) * dsb.x - 16.0f * dsb.y));
}
#endif

#if defined(DATA_A_Q5_1)
i32vec2 repack(uint ib, uint iqs) {
    // Use 4-byte loads since a q5_1 block (24 bytes) is divisible by 4
    const uint32_t vui = data_a_packed32[ib].qs[iqs];
    const int32_t qh = int32_t(data_a_packed32[ib].qh >> (4 * iqs));
    const int32_t v0 = int32_t(vui & 0x0F0F0F0F)
                     | ((qh & 0xF) * 0x02040810) & 0x10101010; // (0,1,2,3) -> (4,12,20,28)

    const int32_t v1 = int32_t((vui >> 4) & 0x0F0F0F0F)
                     | (((qh >> 16) & 0xF) * 0x02040810) & 0x10101010; // (16,17,18,19) -> (4,12,20,28)

    return i32vec2(v0, v1);
}

ACC_TYPE mul_q8_1(int32_t q_sum, vec2 dma, vec2 dsb) {
    return ACC_TYPE(float(q_sum) * dma.x * dsb.x + dma.y * dsb.y);
}
#endif

#if defined(DATA_A_Q8_0)
int32_t repack(uint ib, uint iqs) {
    // Use 2-byte loads since a q8_0 block (34 bytes) is not divisible by 4
    return pack32(i16vec2(data_a[ib].qs[iqs * 2    ],
                          data_a[ib].qs[iqs * 2 + 1]));
}

ACC_TYPE mul_q8_1(int32_t q_sum, float da, vec2 dsb) {
    return ACC_TYPE(float(q_sum) * da * dsb.x);
}
#endif

// ---------------------------------------------------------------------------
// Legacy K quants (Q2_K..Q6_K). A BK=32 tile maps to one 32-element group g
// of a 256-element block; the group is sub-blocks 2g and 2g+1 for the
// per-16-scale types (Q2_K/Q3_K/Q6_K), or the single 32-element sub-block g
// for the per-32-scale types (Q4_K/Q5_K).
// ---------------------------------------------------------------------------

// Q2_K nibble-packed staging (block_a_to_shmem / block_a_to_registers /
// mmq_dot_product) is defined at the end of this file.

// Q3_K nibble-packed staging (block_a_to_shmem / block_a_to_registers /
// mmq_dot_product) is defined at the end of this file.

#if defined(DATA_A_Q4_K) || defined(DATA_A_Q5_K)
// Q4_K and Q5_K share the same 6-bit per-32 scale/min packing (scales[12]).
uint q45_k_scales_byte(uint blk, uint b) {
    const uint16_t w = data_a[blk].scales[b >> 1u];
    return (b & 1u) != 0u ? uint(w) >> 8 : uint(w) & 0xffu;
}

void q45_k_scale_min(uint blk, uint g, out uint sc, out uint mb) {
    if (g < 4u) {
        sc = q45_k_scales_byte(blk, g) & 0x3Fu;
        mb = q45_k_scales_byte(blk, g + 4u) & 0x3Fu;
    } else {
        sc = (q45_k_scales_byte(blk, g + 4u) & 0xFu) | ((q45_k_scales_byte(blk, g - 4u) >> 6u) << 4u);
        mb = (q45_k_scales_byte(blk, g + 4u) >> 4u) | ((q45_k_scales_byte(blk, g) >> 6u) << 4u);
    }
}
#endif

// Q4_K nibble-packed staging (block_a_to_shmem / block_a_to_registers /
// mmq_dot_product) is defined at the end of this file.

// Q5_K and Q6_K byte-packed staging (block_a_to_shmem / block_a_to_registers /
