// Lookup tables for the IQK (QK_K=256) and KT quant families.
// Values mirror ggml-common.h (iq2nl_values, iq2kl_values, iq3nl_values,
// iq4k_values, iq5nl_values, iq6nl_values).

#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_16bit_storage : require
#ifdef IQK_USE_DOT4
#extension GL_EXT_integer_dot_product : require
#endif

// Byte-addressed weight buffer shared by the IQK/KT dequant and mul_mat_vec shaders
layout (binding = 0) readonly buffer A {uint8_t data_a[];};

// Unpack a 16-bit IEEE half to float (helper for byte-addressed blocks)
float iqk_f16_to_f32(uint u) {
    const uint sign = (u >> 15) & 1u;
    const uint exp  = (u >> 10) & 0x1Fu;
    const uint man  = u & 0x3FFu;
    float f;
    if (exp == 0u) {
        f = ldexp(float(man), -24);
    } else if (exp == 31u) {
        f = 1.0f / 0.0f; // inf/nan
    } else {
        f = ldexp(float(man) + 1024.0f, int(exp) - 25);
    }
    return sign != 0u ? -f : f;
}

uint iqk_load_u16(uint off) {
    return uint(data_a[off]) | (uint(data_a[off + 1]) << 8);
}

uint iqk_load_u32(uint off) {
    return uint(data_a[off]) | (uint(data_a[off + 1]) << 8) | (uint(data_a[off + 2]) << 16) | (uint(data_a[off + 3]) << 24);
}

// KT-family value decode: 4 hash rounds of x *= ka produce 4 values
// (see QuantizerIQKT::set_values with is_int = true). x is advanced so a
// second call continues the chain. The result can be negated per value via
// sign_mask (bit k set negates value k).
vec4 iqk_hash_values(inout uint x, bool is_abs, uint sign_mask) {
    vec4 res;
    [[unroll]] for (int k = 0; k < 4; ++k) {
        x *= 0xCBAC1FEDu;
        const uint s = x & 0x3F3F3F3Fu;
#ifdef IQK_USE_DOT4
        // one dot4 replaces the 4-shift + 3-add byte sum
        float v = float(dotPacked4x8EXT(int(s), 0x01010101) - 126);
#else
        float v = float(int((s & 0xffu) + ((s >> 8) & 0xffu) + ((s >> 16) & 0xffu) + ((s >> 24) & 0xffu)) - 126);
#endif
        if (is_abs) v = abs(v);
        if (((sign_mask >> k) & 1u) != 0u) v = -v;
        res[k] = v;
    }
    return res;
}

