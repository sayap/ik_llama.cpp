// Lookup tables for the IQK (QK_K=256) and KT quant families.
// Values mirror ggml-common.h (iq2nl_values, iq2kl_values, iq3nl_values,
// iq4k_values, iq5nl_values, iq6nl_values).

#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_16bit_storage : require
#ifdef IQK_USE_DOT4
#extension GL_EXT_integer_dot_product : require
#endif

// Byte-addressed weight buffer shared by the IQK/KT dequant and mul_mat_vec shaders.
// The coopmat2 matmul (mul_mm_cm2.comp) declares its own binding-0 buffer (as
// uint8_t for the IQK types), so it defines IQK_TABLES_NO_BINDING before including
// this file.
#ifndef IQK_TABLES_NO_BINDING
layout (binding = 0) readonly buffer A {uint8_t data_a[];};
#endif

// Unpack a 16-bit IEEE half to float (helper for byte-addressed blocks)
float iqk_f16_to_f32(uint u) {
    const uint sign = (u >> 15) & 1u;
    const uint exp  = (u >> 10) & 0x1Fu;
    const uint man  = u & 0x3FFu;
    float f;
    if (exp == 0u) {
        f = ldexp(float(man), -24);
    } else if (exp == 31u) {
        f = 1.0f / 0.0f; // inf/nan
    } else {
        f = ldexp(float(man) + 1024.0f, int(exp) - 25);
    }
    return sign != 0u ? -f : f;
}

uint iqk_load_u16(uint off) {
    return uint(data_a[off]) | (uint(data_a[off + 1]) << 8);
}

uint iqk_load_u32(uint off) {
    return uint(data_a[off]) | (uint(data_a[off + 1]) << 8) | (uint(data_a[off + 2]) << 16) | (uint(data_a[off + 3]) << 24);
}

// KT-family value decode: 4 hash rounds of x *= ka produce 4 values
// (see QuantizerIQKT::set_values with is_int = true). x is advanced so a
// second call continues the chain. The result can be negated per value via
// sign_mask (bit k set negates value k).
vec4 iqk_hash_values(inout uint x, bool is_abs, uint sign_mask) {
    vec4 res;
    [[unroll]] for (int k = 0; k < 4; ++k) {
        x *= 0xCBAC1FEDu;
        const uint s = x & 0x3F3F3F3Fu;
#ifdef IQK_USE_DOT4
        // one dot4 replaces the 4-shift + 3-add byte sum
        float v = float(dotPacked4x8EXT(int(s), 0x01010101) - 126);
#else
        float v = float(int((s & 0xffu) + ((s >> 8) & 0xffu) + ((s >> 16) & 0xffu) + ((s >> 24) & 0xffu)) - 126);
#endif
        if (is_abs) v = abs(v);
        if (((sign_mask >> k) & 1u) != 0u) v = -v;
        res[k] = v;
    }
    return res;
}

#ifdef IQK_USE_DOT4
// Packed-int8 variant of iqk_hash_values for the Q8_1 activation dot: the four
// decoded values are returned in one int32 (one byte per value), ready for
// dotPacked4x8EXT against the quantized activations.
int iqk_hash_values_packed(inout uint x, bool is_abs, uint sign_mask) {
    int packed = 0;
    [[unroll]] for (int k = 0; k < 4; ++k) {
        x *= 0xCBAC1FEDu;
        const uint s = x & 0x3F3F3F3Fu;
        int v = dotPacked4x8EXT(int(s), 0x01010101) - 126;
        if (is_abs) v = abs(v);
        if (((sign_mask >> k) & 1u) != 0u) v = -v;
        packed |= (v & 0xff) << (8 * k);
    }
    return packed;
}
#endif

// 2-bit nonlinear values (two 4-entry tables)
const int8_t iq2nl_values[8] = {
    int8_t(-31), int8_t(-13), int8_t(1), int8_t(17),
    int8_t(-26), int8_t(-8),  int8_t(6), int8_t(22),
};

// Packed iq2nl_values: 4 int8 entries per uint32 (low byte first).
const uint iq2nl_values_packed[2] = {
    uint(0x1101f3e1u), uint(0x1606f8e6u),
};

int iq2nl_value_packed(uint index) {
    const int v = int((iq2nl_values_packed[index / 4u] >> (8u * (index % 4u))) & 0xffu);
    return v >= 128 ? v - 256 : v;
}

