#version 450

#include "dequant_head.comp"
#include "iqk_tables.comp"
#include "dequant_iqk_common.comp"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

#define QUANT_K 256
#define BLOCK_BYTES 56
#define META 4

void main() {
    // 32 threads per block: thread (g, j) handles the 8 elements of
    // sub-block g (of 8), byte j (of 4).
    const uint ib = gl_WorkGroupID.x * 8 + gl_LocalInvocationID.x / 32;
    const uint g  = (gl_LocalInvocationID.x % 32) / 4;
    const uint j  = gl_LocalInvocationID.x % 4;

    if (ib >= p.nel / QUANT_K) {
        return;
    }

    const uint nbpb = p.K;
    const uint meta = p.stride_a;
    const uint row_bytes = meta + nbpb * BLOCK_BYTES;
    const uint row = ib / nbpb;
    const uint block_byte = row * row_bytes + META + (ib % nbpb) * BLOCK_BYTES;

    const float d = uintBitsToFloat(data_a32[(row * row_bytes) / 4]);
    const uint sh01 = data_a32[block_byte / 4];
    const uint sh23 = data_a32[block_byte / 4 + 1];
    const uint ql = data_a32[(block_byte + 8) / 4 + g];
    const uint qh = data_a32[(block_byte + 40) / 4 + (g % 4)];
    const uint b_idx = QUANT_K * ib + 32 * g + 8 * j;

    const uint sh_byte = (g < 4 ? sh01 : sh23) >> (8 * (g & 3));
    const float dl = d * float(iq4k_values[sh_byte & 0xFu]);
    const uint sh_shift = 8 - 4 * (g / 4);

    const uint qlb = (ql >> (8 * j)) & 0xffu;
    const uint qhb = (qh >> (8 * j)) & 0xffu;
    uint x = qlb
           + 4096u
           + ((qhb << sh_shift) & 0xf00u)
           + ((sh_byte << (8 - j)) & 0x1000u);
    const vec4 v0 = iqk_hash_values(x, false, 0u);
    const vec4 v1 = iqk_hash_values(x, false, 0u);
    iqk_store4(b_idx,     dl * v0);
    iqk_store4(b_idx + 4, dl * v1);
}
