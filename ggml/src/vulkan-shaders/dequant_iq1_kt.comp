#version 450

#include "dequant_head.comp"
#include "iqk_tables.comp"
#include "dequant_iqk_common.comp"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

#define QUANT_K 256
#define BLOCK_BYTES 56
#define META 4

void main() {
    const uint ib = gl_WorkGroupID.x * 32 + gl_LocalInvocationID.x / 8;
    const uint ib32 = gl_LocalInvocationID.x % 8;

    if (ib >= p.nel / QUANT_K) {
        return;
    }

    const uint nbpb = p.K;
    const uint meta = p.stride_a;
    const uint row_bytes = meta + nbpb * BLOCK_BYTES;
    const uint row = ib / nbpb;
    const uint block_byte = row * row_bytes + META + (ib % nbpb) * BLOCK_BYTES;

    const float d = uintBitsToFloat(data_a32[(row * row_bytes) / 4]);
    const uint sh01 = data_a32[block_byte / 4];
    const uint sh23 = data_a32[block_byte / 4 + 1];
    const uint ql = data_a32[(block_byte + 8) / 4 + ib32];
    const uint qh = data_a32[(block_byte + 40) / 4 + (ib32 % 4)];
    const uint b_idx = QUANT_K * ib + 32 * ib32;

    const uint sh_byte = (ib32 < 4 ? sh01 : sh23) >> (8 * (ib32 & 3));
    const float dl = d * float(iq4k_values[sh_byte & 0xFu]);
    const uint sh_shift = 8 - 4 * (ib32 / 4);

    [[unroll]] for (uint j = 0; j < 4; ++j) {
        const uint qlb = (ql >> (8 * j)) & 0xffu;
        const uint qhb = (qh >> (8 * j)) & 0xffu;
        uint x = qlb
               + 4096u
               + ((qhb << sh_shift) & 0xf00u)
               + ((sh_byte << (8 - j)) & 0x1000u);
        const vec4 v0 = iqk_hash_values(x, false, 0u);
        const vec4 v1 = iqk_hash_values(x, false, 0u);
        iqk_store4(b_idx + 8 * j,     dl * v0);
        iqk_store4(b_idx + 8 * j + 4, dl * v1);
    }
}
