#version 450

#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

#include "mul_mat_vec_iqk_base_q8_1.comp"

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

#define QUANT_K 256
#define BLOCK_BYTES 128
#define META 4

FLOAT_TYPE temp[NUM_COLS][NUM_ROWS];

void calc_superblock(const uint a_byte, const uint b_offset, const uint itid, const uint i,
                     const uint num_blocks_per_row, const uint first_row, const uint num_rows) {
    // 16 threads per block: ib32 = itid/2 (0..7), half = itid%2.
    // Each thread handles 16 elements = 4 groups of 4 values (j = 4*half..4*half+3).
    const uint ib32 = itid / 2;
    const uint h = itid % 2;
    const uint e = 32 * ib32 + 16 * h;

    const uint y_idx = i * QUANT_K + e;
    const uint row_bytes = p.stride_a + num_blocks_per_row * BLOCK_BYTES;

    [[unroll]] for (uint n = 0; n < num_rows; ++n) {
        const uint row_byte = a_byte + (first_row + n) * row_bytes;
        const uint block_byte = row_byte + META + i * BLOCK_BYTES;

        const float d = uintBitsToFloat(iqk_load_u32(row_byte));
        const uint qs32 = iqk_load_u32(block_byte + 4 * ib32);
        const float dl = d * (float((qs32 & 0xffu) >> 1) - 64.0f);
        const uint idx0 = ((qs32 & 1u) << 15) + 4096u;

        const uint ql_off = 32 + 8 * ib32;
        const uint qh_off = 96 + 8 * (ib32 % 4);
        const uint sh_shift = 8 - 4 * (ib32 / 4);

        [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
            const uint b8 = (j * p.batch_stride_b + b_offset + y_idx) / 32;
            const vec2 ds = vec2(data_b[b8].ds);
            const float d8 = ds.x;

            const int q0 = data_b[b8].qs[4 * h + 0];
            const int q1 = data_b[b8].qs[4 * h + 1];
            const int q2 = data_b[b8].qs[4 * h + 2];
            const int q3 = data_b[b8].qs[4 * h + 3];

            const uint j0 = 4 * h;
            const uint sh0 = qs32 >> (8 + 3 * j0);
            uint x0 = uint(data_a[block_byte + ql_off + j0])
                    + ((uint(data_a[block_byte + qh_off + j0]) << sh_shift) & 0xf00u)
                    + ((sh0 & 7u) << 12)
                    + idx0;
            const int v0 = iqk_hash_values_packed(x0, false, 0u);

            const uint sh1 = qs32 >> (8 + 3 * (j0 + 1));
            uint x1 = uint(data_a[block_byte + ql_off + j0 + 1])
                    + ((uint(data_a[block_byte + qh_off + j0 + 1]) << sh_shift) & 0xf00u)
                    + ((sh1 & 7u) << 12)
                    + idx0;
            const int v1 = iqk_hash_values_packed(x1, false, 0u);

            const uint sh2 = qs32 >> (8 + 3 * (j0 + 2));
            uint x2 = uint(data_a[block_byte + ql_off + j0 + 2])
                    + ((uint(data_a[block_byte + qh_off + j0 + 2]) << sh_shift) & 0xf00u)
                    + ((sh2 & 7u) << 12)
                    + idx0;
            const int v2 = iqk_hash_values_packed(x2, false, 0u);

            const uint sh3 = qs32 >> (8 + 3 * (j0 + 3));
            uint x3 = uint(data_a[block_byte + ql_off + j0 + 3])
                    + ((uint(data_a[block_byte + qh_off + j0 + 3]) << sh_shift) & 0xf00u)
                    + ((sh3 & 7u) << 12)
                    + idx0;
            const int v3 = iqk_hash_values_packed(x3, false, 0u);

            int sumi = 0;
            sumi += dotPacked4x8EXT(v0, q0);
            sumi += dotPacked4x8EXT(v1, q1);
            sumi += dotPacked4x8EXT(v2, q2);
            sumi += dotPacked4x8EXT(v3, q3);

            temp[j][n] = fma(dl * d8, float(sumi), temp[j][n]);
        }
    }
}

void compute_outputs(const uint32_t first_row, const uint32_t num_rows) {
    uint a_byte, b_offset, d_offset;
    get_offsets(a_byte, b_offset, d_offset);

    const uint num_blocks_per_row = p.ncols / QUANT_K;

    const uint blocks_per_wg = gl_WorkGroupSize.x / 16;
    const uint tid = gl_LocalInvocationID.x;
    const uint itid = tid % 16;
    const uint ix = tid / 16;

    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        [[unroll]] for (uint i = 0; i < NUM_ROWS; ++i) {
            temp[j][i] = FLOAT_TYPE(0);
        }
    }

    [[unroll]] for (uint i = ix; i < num_blocks_per_row; i += blocks_per_wg)
        calc_superblock(a_byte, b_offset, itid, i, num_blocks_per_row, first_row, num_rows);

    reduce_result(temp, d_offset, first_row, num_rows, tid);
}

void main() {
    const uint first_row = NUM_ROWS * (gl_WorkGroupID.x + gl_NumWorkGroups.x * gl_WorkGroupID.z);

    if (first_row + NUM_ROWS <= p.stride_d) {
        compute_outputs(first_row, NUM_ROWS);
    } else {
        if (first_row >= p.stride_d) {
            return;
        }
        compute_outputs(first_row, p.stride_d - first_row);
    }
}
