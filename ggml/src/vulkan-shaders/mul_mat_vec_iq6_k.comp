#version 450

#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

#include "mul_mat_vec_iqk_base.comp"

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

#define QUANT_K 256
#define BLOCK_BYTES 212

FLOAT_TYPE temp[NUM_COLS][NUM_ROWS];

void calc_superblock(const uint a_byte, const uint b_offset, const uint itid, const uint i,
                     const uint num_blocks_per_row, const uint first_row, const uint num_rows) {
    // 16 threads per block: ib64 = itid/4 (0..3), quarter = itid%4 (0..3)
    const uint ib64 = itid / 4;
    const uint quarter = itid % 4;
    const uint e = 64 * ib64 + 16 * quarter;
    const uint shift = 4 * (ib64 % 2);

    const uint y_idx = i * QUANT_K + e;
    const uint row_bytes = p.stride_a + num_blocks_per_row * BLOCK_BYTES;

    [[unroll]] for (uint n = 0; n < num_rows; ++n) {
        const uint block_byte = a_byte + (first_row + n) * row_bytes + p.stride_a + i * BLOCK_BYTES;

        const uint extra = iqk_load_u16(block_byte + 2);
        const uint e_shift = extra >> (4 * ib64);
        const float d = iqk_f16_to_f32(iqk_load_u16(block_byte));

        const float dl = d * float(int8_t(data_a[block_byte + 4 + 4 * ib64 + quarter]));
        const uint v_off = ((e_shift & (1u << quarter)) != 0) ? 64 : 0;
        const uint qs_off = 20 + 32 * ib64 + 16 * (quarter & 1);
        const uint qh_off = 148 + 32 * (ib64 / 2) + 16 * (quarter & 1);
        const bool use_hi_bits = quarter >= 2;

        [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
            const uint b4 = (j * p.batch_stride_b + b_offset + y_idx) / 4;
            vec4 b0 = vec4(data_b_v4[b4 + 0]);
            vec4 b1 = vec4(data_b_v4[b4 + 1]);
            vec4 b2 = vec4(data_b_v4[b4 + 2]);
            vec4 b3 = vec4(data_b_v4[b4 + 3]);
            FLOAT_TYPE sum = FLOAT_TYPE(0.0f);
            [[unroll]] for (uint k = 0; k < 4; ++k) {
                const uint q = data_a[block_byte + qs_off + k];
                const uint hb = data_a[block_byte + qh_off + k];
                const uint idx = use_hi_bits
                    ? ((q >> 4) | (((hb >> shift) & 0xcu) << 2))
                    : ((q & 0xFu) | (((hb >> shift) & 0x3u) << 4));
                sum += FLOAT_TYPE(b0[k]) * FLOAT_TYPE(float(iq6nl_values[idx + v_off]));
            }
            [[unroll]] for (uint k = 0; k < 4; ++k) {
                const uint q = data_a[block_byte + qs_off + 4 + k];
                const uint hb = data_a[block_byte + qh_off + 4 + k];
                const uint idx = use_hi_bits
                    ? ((q >> 4) | (((hb >> shift) & 0xcu) << 2))
                    : ((q & 0xFu) | (((hb >> shift) & 0x3u) << 4));
                sum += FLOAT_TYPE(b1[k]) * FLOAT_TYPE(float(iq6nl_values[idx + v_off]));
            }
            [[unroll]] for (uint k = 0; k < 4; ++k) {
                const uint q = data_a[block_byte + qs_off + 8 + k];
                const uint hb = data_a[block_byte + qh_off + 8 + k];
                const uint idx = use_hi_bits
                    ? ((q >> 4) | (((hb >> shift) & 0xcu) << 2))
                    : ((q & 0xFu) | (((hb >> shift) & 0x3u) << 4));
                sum += FLOAT_TYPE(b2[k]) * FLOAT_TYPE(float(iq6nl_values[idx + v_off]));
            }
            [[unroll]] for (uint k = 0; k < 4; ++k) {
                const uint q = data_a[block_byte + qs_off + 12 + k];
                const uint hb = data_a[block_byte + qh_off + 12 + k];
                const uint idx = use_hi_bits
                    ? ((q >> 4) | (((hb >> shift) & 0xcu) << 2))
                    : ((q & 0xFu) | (((hb >> shift) & 0x3u) << 4));
                sum += FLOAT_TYPE(b3[k]) * FLOAT_TYPE(float(iq6nl_values[idx + v_off]));
            }
            temp[j][n] = fma(dl, sum, temp[j][n]);
        }
    }
}

void compute_outputs(const uint32_t first_row, const uint32_t num_rows) {
    uint a_byte, b_offset, d_offset;
    get_offsets(a_byte, b_offset, d_offset);

    const uint num_blocks_per_row = p.ncols / QUANT_K;

    const uint blocks_per_wg = gl_WorkGroupSize.x / 16;
    const uint tid = gl_LocalInvocationID.x;
    const uint itid = tid % 16;
    const uint ix = tid / 16;

    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        [[unroll]] for (uint i = 0; i < NUM_ROWS; ++i) {
            temp[j][i] = FLOAT_TYPE(0);
        }
    }

    [[unroll]] for (uint i = ix; i < num_blocks_per_row; i += blocks_per_wg)
        calc_superblock(a_byte, b_offset, itid, i, num_blocks_per_row, first_row, num_rows);

    reduce_result(temp, d_offset, first_row, num_rows, tid);
}

void main() {
    const uint first_row = NUM_ROWS * (gl_WorkGroupID.x + gl_NumWorkGroups.x * gl_WorkGroupID.z);

    if (first_row + NUM_ROWS <= p.stride_d) {
        compute_outputs(first_row, NUM_ROWS);
    } else {
        if (first_row >= p.stride_d) {
            return;
        }
        compute_outputs(first_row, p.stride_d - first_row);
    }
}
