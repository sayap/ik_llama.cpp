    const float dl = d * float(int8_t(data_a[block_byte + 4 + 4 * ib64 + part]));
    const uint v_off = ((e_shift & (1u << part)) != 0) ? 64 : 0;
    const uint q = data_a[block_byte + 20 + 32 * ib64 + 16 * (part & 1) + j];
    const uint hb = data_a[block_byte + 148 + 32 * (ib64 / 2) + 16 * (part & 1) + j];
    const uint idx = (part < 2)
        ? ((q & 0xFu) | (((hb >> shift) & 0x3u) << 4))
        : ((q >> 4) | (((hb >> shift) & 0xcu) << 2));
    return dl * float(iq6nl_values[idx + v_off]);
}
#elif defined(DATA_A_IQ2_KS)
