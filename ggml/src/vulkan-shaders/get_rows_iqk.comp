    const uint voff = ((part == 0 ? (e_shift & 1u) : (e_shift & 2u)) != 0) ? 4 : 0;
    const uint q = data_a[block_byte + 6 + 32 * (ib64 / 2) + j];
    return dl * float(iq2nl_values[((q >> (shift + 2 * part)) & 3) + voff]);
}
#elif defined(DATA_A_IQ3_KS)
#define BLOCK_BYTES 102
#define META 2
#define QUANT_K 256
float dequant_element(uint block_byte, uint row_byte, uint e) {
    const uint k = e / 32;
    const uint j = e % 32;
    const uint extra = iqk_load_u16(block_byte);
    const float d = iqk_f16_to_f32(iqk_load_u16(row_byte));
    const uint sc = data_a[block_byte + 2 + k % 4];
    const float dl = d * (float(((sc >> (4 * (k / 4))) & 0xFu) | (((extra >> k) & 1u) << 4)) - 16.0f);
    const uint v_off = ((extra >> (8 + k)) & 1u) != 0 ? 8 : 0;
    const uint q = data_a[block_byte + 6 + 32 * (k / 4) + j];
    const uint hb = data_a[block_byte + 70 + j];
    const uint idx = ((q >> (2 * (k % 4))) & 3u) | (((hb >> k) & 1u) << 2);
    return dl * float(iq3nl_values[idx + v_off]);
}
#elif defined(DATA_A_IQ4_KS)
#define BLOCK_BYTES 136
#define META 4
#define QUANT_K 256
float dequant_element(uint block_byte, uint row_byte, uint e) {
    const uint ib32 = e / 32;
    const uint j = e % 16;
    const uint h = (e / 16) % 2;
    const float d = uintBitsToFloat(iqk_load_u32(row_byte));
    const uint sc = data_a[block_byte + ib32];
    const float dl = d * (float(sc & 254u) - 127.0f);
    const uint v_off = (sc & 1u) != 0 ? 16 : 0;
    const uint q = data_a[block_byte + 8 + 16 * ib32 + j];
    return dl * float(iq4k_values[(h == 0 ? (q & 0xFu) : (q >> 4)) + v_off]);
}
#elif defined(DATA_A_IQ4_KSS)
#define BLOCK_BYTES 128
#define META 4
#define QUANT_K 256
float dequant_element(uint block_byte, uint row_byte, uint e) {
    const uint ib32 = e / 32;
    const uint j = e % 16;
    const uint h = (e / 16) % 2;
    const float d = uintBitsToFloat(iqk_load_u32(row_byte));
    uint ls = 0;
    uint aux16[8];
    const uint qs16_off = 16 * ib32;
    for (uint k = 0; k < 8; ++k) {
        const uint q16 = iqk_load_u16(block_byte + qs16_off + 2 * k);
        uint a = q16 & 0xfffeu;
        a ^= a >> 1;
        aux16[k] = a;
        ls |= (q16 & 1u) << k;
    }
    const float dl = d * (float(ls & 254u) - 127.0f);
    const uint v_off = (ls & 1u) != 0 ? 16 : 0;
    const uint a8 = (aux16[j / 2] >> (8 * (j & 1))) & 0xffu;
    return dl * float(iq4k_values[(h == 0 ? (a8 & 0xFu) : (a8 >> 4)) + v_off]);
}
#elif defined(DATA_A_IQ5_KS)
#define BLOCK_BYTES 168
#define META 4
#define QUANT_K 256
float dequant_element(uint block_byte, uint row_byte, uint e) {
    const uint ib64 = e / 64;
    const uint j = e % 32;
    const uint part = (e / 32) % 2;
    const float d = uintBitsToFloat(iqk_load_u32(row_byte));
    const uint sc = data_a[block_byte + 2 * ib64 + part];
    const float dl = d * (float(sc & 254u) - 127.0f);
    const uint v_off = (sc & 1u) != 0 ? 32 : 0;
    const uint sft_h = 2 * ib64 + part;
    const uint q = data_a[block_byte + 8 + 32 * ib64 + j];
    const uint hb = data_a[block_byte + 136 + j];
    const uint idx = (part == 0)
        ? ((q & 0xFu) | (((hb >> sft_h) & 1u) << 4))
        : ((q >> 4) | (((hb >> sft_h) & 1u) << 4));
    return dl * float(iq5nl_values[idx + v_off]);
}
#elif defined(DATA_A_IQ2_KL)
#define BLOCK_BYTES 86
#define META 2
#define QUANT_K 256
float dequant_element(uint block_byte, uint row_byte, uint e) {
    const uint ib64 = e / 64;
    const uint j = e % 16;
    const uint part = (e / 32) % 2;
    const uint m = e % 2;
    const uint jj = (e % 32) / 2;
    const float d = iqk_f16_to_f32(iqk_load_u16(row_byte));
    const uint scales_h = iqk_load_u16(block_byte);
    const uint sc = data_a[block_byte + 2 + (2 * ib64 + part) % 4];
    const float dl = d * (float(((sc >> (4 * (ib64 / 2))) & 0xFu) | (((scales_h >> (4 * ib64 + 2 * part)) & 3u) << 4)) - 32.0f);
    const uint sft_h = 2 * ib64 + part;
    const uint q = data_a[block_byte + 6 + 16 * ib64 + jj];
    const uint hb = data_a[block_byte + 70 + jj];
    const uint idx = (part == 0)
        ? ((q & 0xFu) | (((hb >> sft_h) & 1u) << 4))
        : ((q >> 4) | (((hb >> sft_h) & 1u) << 4));
    const uint v = iq2kl_values[idx];
    return dl * float(int8_t(m == 0 ? (v & 0xffu) : (v >> 8)));
}
#elif defined(DATA_A_IQ1_KT)
#define BLOCK_BYTES 56
#define META 4
#define QUANT_K 256
float dequant_element(uint block_byte, uint row_byte, uint e) {
    const uint ib32 = e / 32;
    const uint j = (e % 32) / 8;
    const uint k = e % 8;
    const float d = uintBitsToFloat(iqk_load_u32(row_byte));
    const uint sh_byte = data_a[block_byte + ib32];
    const float dl = d * float(iq4k_values[sh_byte & 0xFu]);
    const uint ql_off = 8 + 4 * ib32;
    const uint qh_off = 40 + 4 * (ib32 % 4);
    const uint sh_shift = 8 - 4 * (ib32 / 4);
    uint x = uint(data_a[block_byte + ql_off + j])
           + 4096u
           + ((uint(data_a[block_byte + qh_off + j]) << sh_shift) & 0xf00u)
           + ((sh_byte << (8 - j)) & 0x1000u);
    // the k-th value of the 8-value group
    for (uint r = 0; r <= k; ++r) {
        x *= 0xCBAC1FEDu;
    }
    const uint s = x & 0x3F3F3F3Fu;
    return dl * float(int((s & 0xffu) + ((s >> 8) & 0xffu) + ((s >> 16) & 0xffu) + ((s >> 24) & 0xffu)) - 126);
}
