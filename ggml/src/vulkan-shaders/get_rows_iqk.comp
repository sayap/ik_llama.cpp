void main() {
    const uint i00 = gl_GlobalInvocationID.x;
    const uint i10 = gl_GlobalInvocationID.y;
    const uint i11 = gl_GlobalInvocationID.z / p.ne12;
    const uint i12 = gl_GlobalInvocationID.z % p.ne12;

    if (i00 >= p.ne00) {
        return;
    }

    const uint i01 = uint(data_b[i10*p.nb10 + i11*p.nb11 + i12*p.nb12]);
    const uint row_byte = i01*p.nb01 + i11*p.nb02 + i12*p.nb03;
    const uint a_byte = row_byte + META + (i00 / QUANT_K) * BLOCK_BYTES;
    const uint d_offset = i10*p.nb21 + i11*p.nb22 + i12*p.nb23;

    data_d[d_offset + i00] = D_TYPE(dequant_element(a_byte, row_byte, i00 % QUANT_K));
}
