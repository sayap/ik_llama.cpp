           + ((uint(data_a[block_byte + qh_off + j]) << sh_shift) & 0xf00u)
           + ((sh & 7u) << 12)
           + idx0;
    for (uint r = 0; r <= k; ++r) {
        x *= 0xCBAC1FEDu;
    }
    const uint s = x & 0x3F3F3F3Fu;
    return dl * float(int((s & 0xffu) + ((s >> 8) & 0xffu) + ((s >> 16) & 0xffu) + ((s >> 24) & 0xffu)) - 126);
