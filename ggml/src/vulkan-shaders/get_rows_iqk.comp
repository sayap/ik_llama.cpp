// GET_ROWS for the IQK / KT quant families. Rows carry an optional per-row
// scale header (row_meta_size), so the src0 strides in the push constants are
// BYTES for these types (ggml_vk_get_rows passes nb0..nb3 directly).
//
// Each thread dequantizes one element of the selected row and writes it out
// (F16 or F32, D_TYPE). The workgroup size matches the pipeline's
// elements-per-workgroup denom (1024): one thread per element.

#version 450

#extension GL_EXT_control_flow_attributes : require
#extension GL_EXT_shader_16bit_storage : require

#include "types.comp"
#include "iqk_tables.comp"

layout (push_constant) uniform parameter
{
    uint ne;
    uint ne00; uint ne01; uint ne02; uint ne03; uint nb00; uint nb01; uint nb02; uint nb03;
    uint ne10; uint ne11; uint ne12; uint ne13; uint nb10; uint nb11; uint nb12; uint nb13;
    uint ne20; uint ne21; uint ne22; uint ne23; uint nb20; uint nb21; uint nb22; uint nb23;
    uint misalign_offsets;
    float param1; float param2; int param3;
} p;

layout (binding = 1) readonly buffer B {int data_b[];};
layout (binding = 2) writeonly buffer D {D_TYPE data_d[];};

layout(local_size_x = 1024, local_size_y = 1, local_size_z = 1) in;

// ---- per-type element dequant -------------------------------------------

#if defined(DATA_A_IQ2_K)
#define BLOCK_BYTES 76
#define META 0
#define QUANT_K 256
float dequant_element(uint block_byte, uint row_byte, uint e) {
    const uint ib32 = e / 32;
    const uint j = e % 16;
    const uint h = (e / 16) % 2;
    const uint shift = 2 * (ib32 % 4);
    const uint extra = iqk_load_u16(block_byte + 2);
    const uint e_shift = extra >> (2 * ib32);
    const float d = iqk_f16_to_f32(iqk_load_u16(block_byte));
    const uint sc = data_a[block_byte + 4 + ib32];
    const float dl = d * (float((sc >> (4 * h)) & 0xFu) - 8.0f);
    const uint voff = ((h == 0 ? (e_shift & 1u) : (e_shift & 2u)) != 0) ? 4 : 0;
    const uint qs = data_a[block_byte + 12 + (ib32 / 4) * 32 + h * 16 + j];
    return dl * float(iq2nl_values[((qs >> shift) & 3) + voff]);
}
#elif defined(DATA_A_IQ3_K)
#define BLOCK_BYTES 110
#define META 0
#define QUANT_K 256
float dequant_element(uint block_byte, uint row_byte, uint e) {
    const uint ib32 = e / 32;
    const uint j = e % 16;
    const uint h = (e / 16) % 2;
    const uint shift_l = 2 * (ib32 % 4);
    const uint shift_h = ib32 % 8;
    const uint extra = iqk_load_u16(block_byte + 2);
    const uint sh = iqk_load_u16(block_byte + 4);
    const uint e_shift = extra >> (2 * ib32);
    const float d = iqk_f16_to_f32(iqk_load_u16(block_byte));
    const uint sc = data_a[block_byte + 6 + ib32];
    const float dl = d * (2.0f * float((sc >> (4 * h)) & 0xFu) + 1.0f) * (((sh >> (2 * ib32 + h)) & 1u) != 0 ? -1.0f : 1.0f);
    const uint voff = ((h == 0 ? (e_shift & 1u) : (e_shift & 2u)) != 0) ? 8 : 0;
    const uint q = (data_a[block_byte + 14 + (ib32 / 4) * 32 + h * 16 + j] >> shift_l) & 3u;
    const uint hb = (data_a[block_byte + 78 + h * 16 + j] >> shift_h) & 1u;
    return dl * float(iq3nl_values[(q | (hb << 2)) + voff]);
}
