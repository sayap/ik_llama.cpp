    const uint e_shift = extra >> (2 * ib32);
    const float d = iqk_f16_to_f32(iqk_load_u16(block_byte));
    const uint sh = data_a[block_byte + 4 + ib32 / 2] >> (4 * (ib32 % 2));
    const uint sc = data_a[block_byte + 8 + ib32];
    const float dl = d * (float(((sc >> (4 * h)) & 0xFu) | ((sh << (4 - 2 * h)) & 0x30u)) - 32.0f);
    const uint voff = ((h == 0 ? (e_shift & 1u) : (e_shift & 2u)) != 0) ? 16 : 0;
    const uint q = data_a[block_byte + 16 + 16 * ib32 + j];
    return dl * float(iq4k_values[(h == 0 ? (q & 0xFu) : (q >> 4)) + voff]);
}
#elif defined(DATA_A_IQ5_K)
#define BLOCK_BYTES 176
#define META 0
#define QUANT_K 256
float dequant_element(uint block_byte, uint row_byte, uint e) {
    const uint ib64 = e / 64;
    const uint j = e % 16;
    const uint part = (e / 16) % 4;
    const uint shift = 2 * ib64;
    const uint extra = iqk_load_u16(block_byte + 2);
    const uint e_shift = extra >> (4 * ib64);
    const float d = iqk_f16_to_f32(iqk_load_u16(block_byte));
    const uint sh = data_a[block_byte + 4 + ib64];
    float dl;
    uint v_off;
    uint qs_off;
    if (part < 2) {
        const uint sl = data_a[block_byte + 8 + 2 * ib64];
        dl = d * (float(((sl >> (4 * part)) & 0xFu) | ((sh << (4 - 2 * part)) & 0x30u)) - 32.0f);
        v_off = ((e_shift & (1u << part)) != 0) ? 32 : 0;
        qs_off = 16 + 32 * ib64 + 16 * (part & 1);
    } else {
        const uint sl = data_a[block_byte + 8 + 2 * ib64 + 1];
        dl = d * (float(((sl >> (4 * (part - 2))) & 0xFu) | ((sh >> (2 * (part - 2))) & 0x30u)) - 32.0f);
        v_off = ((e_shift & (1u << part)) != 0) ? 32 : 0;
        qs_off = 16 + 32 * ib64 + 16 * (part & 1);
    }
    const uint q = data_a[block_byte + qs_off + j];
    const uint hb = data_a[block_byte + 144 + 16 * (part & 1) + j];
    const uint idx = (part < 2)
        ? ((q & 0xFu) | (((hb >> shift) & 1u) << 4))
        : ((q >> 4) | (((hb >> shift) & 2u) << 3));
    return dl * float(iq5nl_values[idx + v_off]);
}
