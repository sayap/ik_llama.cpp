#version 450

#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

#include "mul_mat_vec_iqk_base_q8_1.comp"
#include "iq2k_table.comp"

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

// uint32 view of the byte-addressed weight buffer (IQ2_K has no row meta and a
// 76-byte block, so every block/field offset here is 4-byte aligned).
layout (binding = 0) readonly buffer A32 { uint data_a32[]; };

#define QUANT_K 256
#define BLOCK_BYTES 76

shared uint iq2k_shmem[2][256];

FLOAT_TYPE temp[NUM_COLS][NUM_ROWS];

void calc_superblock(const uint a_byte, const uint b_offset, const uint itid, const uint i,
                     const uint num_blocks_per_row, const uint first_row, const uint num_rows) {
    // 8 threads per block, CUDA-style: each thread handles 8 values in each of
    // four consecutive Q8_1 blocks.
    const uint group = itid / 4;
    const uint sub = itid % 4;

    const uint row_bytes = p.stride_a + num_blocks_per_row * BLOCK_BYTES;

    [[unroll]] for (uint n = 0; n < num_rows; ++n) {
        const uint block_dw = (a_byte + (first_row + n) * row_bytes + p.stride_a + i * BLOCK_BYTES) >> 2;

        const uint head = data_a32[block_dw];
        const float d = iqk_f16_to_f32(head & 0xffffu);
        const uint extra16 = head >> 16;
        const uint extra_word = extra16 >> (8 * group + sub / 2);

        const uint qs_dw = block_dw + 3 + 8 * group + 2 * sub;
        const uint w0 = data_a32[qs_dw + 0];
        const uint w1 = data_a32[qs_dw + 1];

        const uint scales = data_a32[block_dw + 1 + group];
        int s[4];
        [[unroll]] for (uint k = 0; k < 4; ++k) {
            s[k] = int((scales >> (8 * k + 4 * (sub / 2))) & 0xFu) - 8;
        }

        [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
            [[unroll]] for (uint q = 0; q < 4; ++q) {
                const uint b8 = (j * p.batch_stride_b + b_offset + i * QUANT_K) / 32 + 4 * group + q;
                const vec2 ds = vec2(data_b[b8].ds);
                const float d8 = ds.x;

                const int qb0 = data_b[b8].qs[2 * sub + 0];
                const int qb1 = data_b[b8].qs[2 * sub + 1];

                // Extract the four 2-bit indices for this Q8_1 block with one
                // shift+mask: byte b of (w >> 2q) holds w bits 8b+2q..8b+2q+1.
                const int packed_idx0 = int((w0 >> (2 * q)) & 0x03030303u);
                const int packed_idx1 = int((w1 >> (2 * q)) & 0x03030303u);
                const int off0 = dotPacked4x8EXT(packed_idx0, 0x40100401);
                const int off1 = dotPacked4x8EXT(packed_idx1, 0x40100401);
                const uint vsel = ((extra_word >> (2 * q)) & 1u) != 0 ? 1 : 0;

                const int packed0 = int(iq2k_shmem[vsel][off0]);
                const int packed1 = int(iq2k_shmem[vsel][off1]);

                int dot = dotPacked4x8EXT(packed0, qb0);
                dot += dotPacked4x8EXT(packed1, qb1);

                temp[j][n] = fma(d * d8 * float(s[q]), float(dot), temp[j][n]);
            }
        }
    }
}

void compute_outputs(const uint32_t first_row, const uint32_t num_rows) {
    uint a_byte, b_offset, d_offset;
    get_offsets(a_byte, b_offset, d_offset);

    const uint num_blocks_per_row = p.ncols / QUANT_K;

    const uint blocks_per_wg = gl_WorkGroupSize.x / 8;
    const uint tid = gl_LocalInvocationID.x;
    const uint itid = tid % 8;
    const uint ix = tid / 8;

    [[unroll]] for (uint idx = tid; idx < 256; idx += BLOCK_SIZE) {
        iq2k_shmem[0][idx] = iq2k_table[idx];
        iq2k_shmem[1][idx] = iq2k_table[256 + idx];
    }
    barrier();

    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        [[unroll]] for (uint i = 0; i < NUM_ROWS; ++i) {
            temp[j][i] = FLOAT_TYPE(0);
        }
    }

    [[unroll]] for (uint i = ix; i < num_blocks_per_row; i += blocks_per_wg)
        calc_superblock(a_byte, b_offset, itid, i, num_blocks_per_row, first_row, num_rows);

    reduce_result(temp, d_offset, first_row, num_rows, tid);
}

void main() {
    const uint first_row = NUM_ROWS * (gl_WorkGroupID.x + gl_NumWorkGroups.x * gl_WorkGroupID.z);

    if (first_row + NUM_ROWS <= p.stride_d) {
        compute_outputs(first_row, NUM_ROWS);
    } else {
        if (first_row >= p.stride_d) {
            return;
        }
        compute_outputs(first_row, p.stride_d - first_row);
    }
}
