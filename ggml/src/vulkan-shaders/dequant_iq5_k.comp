#version 450

#include "dequant_head.comp"
#include "iqk_tables.comp"
#include "dequant_iqk_common.comp"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

#define QUANT_K 256
#define BLOCK_BYTES 176

// part 0: 4-bit low nibbles, high bit = h bit shift
vec4 iq5k_lo(uint qw, uint hw, uint shift, uint vo) {
    return vec4(
        float(iq5nl_values[((qw & 0xFu) | ((((hw & 0xffu) >> shift) & 1u) << 4)) + vo]),
        float(iq5nl_values[((((qw >> 8) & 0xFu) | ((((hw >> 8) & 0xffu) >> shift & 1u) << 4))) + vo]),
        float(iq5nl_values[((((qw >> 16) & 0xFu) | ((((hw >> 16) & 0xffu) >> shift & 1u) << 4))) + vo]),
        float(iq5nl_values[((((qw >> 24) & 0xFu) | ((((hw >> 24) & 0xffu) >> shift & 1u) << 4))) + vo]));
}

// part 1: 4-bit high nibbles, high bit = h bit shift+1
vec4 iq5k_hi(uint qw, uint hw, uint shift, uint vo) {
    return vec4(
        float(iq5nl_values[((((qw >> 4) & 0xFu) | ((((hw & 0xffu) >> shift) & 2u) << 3))) + vo]),
        float(iq5nl_values[((((qw >> 12) & 0xFu) | ((((hw >> 8) & 0xffu) >> shift & 2u) << 3))) + vo]),
        float(iq5nl_values[((((qw >> 20) & 0xFu) | ((((hw >> 16) & 0xffu) >> shift & 2u) << 3))) + vo]),
        float(iq5nl_values[((((qw >> 28) & 0xFu) | ((((hw >> 24) & 0xffu) >> shift & 2u) << 3))) + vo]));
}

void main() {
    // 64 threads per block: thread (ib64, part, t) decodes one vec4;
    // t < 4 is the low half (j = t), t >= 4 the high half (j = t - 4).
    const uint ib = gl_WorkGroupID.x * 4 + gl_LocalInvocationID.x / 64;
    const uint ib64 = (gl_LocalInvocationID.x % 64) / 16;
    const uint part = (gl_LocalInvocationID.x % 16) / 8;
    const uint t = gl_LocalInvocationID.x % 8;

    if (ib >= p.nel / QUANT_K) {
        return;
    }

    const uint nbpb = p.K;
    const uint meta = p.stride_a;
    const uint row_bytes = meta + nbpb * BLOCK_BYTES;
    const uint block_byte = (ib / nbpb) * row_bytes + meta + (ib % nbpb) * BLOCK_BYTES;

    const uint dw = block_byte / 4;
    const uint head = data_a32[dw];
    const float d = iqk_f16_to_f32(head & 0xffffu);
    const uint extra = head >> 16;
    const uint sh01 = data_a32[dw + 1];
    const uint sl01 = data_a32[dw + 2];
    const uint sl23 = data_a32[dw + 3];
    const uint b_idx = QUANT_K * ib + 64 * ib64 + 32 * part + 4 * t;

    const uint shift = 2 * ib64;
    const uint e = extra >> (4 * ib64);
    const uint sh = (sh01 >> (8 * ib64)) & 0xffu;
    const uint sl_dw = ib64 < 2 ? sl01 : sl23;
    const uint sl0 = (sl_dw >> (16 * (ib64 & 1))) & 0xffu;
    const uint sl1 = (sl_dw >> (16 * (ib64 & 1) + 8)) & 0xffu;
    const uint qs_dw = (block_byte + 16 + 32 * ib64) / 4;
    const uint qh_dw = (block_byte + 144) / 4;
    const uint j = t & 3;

    if (part == 0) {
        const float dl1 = d * (float((sl0 & 0xFu) | ((sh << 4) & 0x30u)) - 32.0f);
        const float dl2 = d * (float(((sl0 >> 4) & 0xFu) | ((sh << 2) & 0x30u)) - 32.0f);
        const uint v1_off = (e & 1u) != 0 ? 32u : 0u;
        const uint v2_off = (e & 2u) != 0 ? 32u : 0u;
        if (t < 4) {
            iqk_store4(b_idx, dl1 * iq5k_lo(data_a32[qs_dw + j], data_a32[qh_dw + j], shift, v1_off));
        } else {
            iqk_store4(b_idx, dl2 * iq5k_lo(data_a32[qs_dw + 4 + j], data_a32[qh_dw + 4 + j], shift, v2_off));
        }
    } else {
        const float dl1 = d * (float((sl1 & 0xFu) | (sh & 0x30u)) - 32.0f);
        const float dl2 = d * (float(((sl1 >> 4) & 0xFu) | ((sh >> 2) & 0x30u)) - 32.0f);
        const uint v1_off = (e & 4u) != 0 ? 32u : 0u;
        const uint v2_off = (e & 8u) != 0 ? 32u : 0u;
        if (t < 4) {
            iqk_store4(b_idx, dl1 * iq5k_hi(data_a32[qs_dw + j], data_a32[qh_dw + j], shift, v1_off));
        } else {
            iqk_store4(b_idx, dl2 * iq5k_hi(data_a32[qs_dw + 4 + j], data_a32[qh_dw + 4 + j], shift, v2_off));
        }
    }
}
