#version 450

#extension GL_EXT_control_flow_attributes : require

// S_V: head dim (16/32/64/128). Workgroup size is S_V.
// CS:  column-group size (rows handled per workgroup, <= S_V and a divisor of S_V).
layout(constant_id = 0) const uint S_V = 128;
layout(constant_id = 1) const uint CS = 32;

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PC {
    uint H_k;
    uint H_v;
    uint n_tokens;
    uint n_seqs;
    uint repeat_type;
    uint v_nb1, v_nb2, v_nb3;
    float scale;
    uint has_saved;
} p;

layout(binding = 0) readonly buffer Q { float q[]; };
layout(binding = 1) readonly buffer K { float k[]; };
layout(binding = 2) readonly buffer V { float v[]; };
layout(binding = 3) readonly buffer G { float g[]; };
layout(binding = 4) readonly buffer B { float b[]; };
layout(binding = 5) readonly buffer S { float state_in[]; };
layout(binding = 6) buffer D { float dst[]; };
layout(binding = 7) buffer SAVED { float saved[]; };

const uint NUM_GROUPS = S_V / CS;

shared float s_k[S_V];
shared float s_q[S_V];
shared float s_red[S_V];
shared float all_sum1[NUM_GROUPS * (CS + 1)];
shared float all_sum2[NUM_GROUPS * (CS + 1)];

void main() {
    const uint head = gl_WorkGroupID.x;
    const uint seq  = gl_WorkGroupID.y;
    const uint sub  = gl_WorkGroupID.z;
    const uint tid  = gl_LocalInvocationID.x;

    const uint col_group = tid / CS;
    const uint row       = tid % CS;
    const uint row_out   = sub * CS + row;

    const uint gqa = p.H_v / p.H_k;
    const uint head_kq = (p.repeat_type == 0u) ? head / gqa : head % (p.H_v / gqa);

    const uint state_size = S_V * S_V;
    const uint state_base = (seq * p.H_v + head) * state_size;
    const uint out_base = seq * (S_V * p.H_v * p.n_tokens) + head * S_V;
    const uint out_token_stride = S_V * p.H_v;

    const uint qkv_head_stride = S_V * p.n_tokens;
    const uint qkv_batch_stride = S_V * p.n_tokens * p.H_k;
    const uint q_base = seq * qkv_batch_stride + head_kq * qkv_head_stride;

    const uint v_base = seq * p.v_nb3 + head * p.v_nb2;

    const uint gb_batch_stride = p.n_tokens * p.H_v;
    const uint gb_base = seq * gb_batch_stride + head;

    // Keep the state in registers: each thread owns CS columns of its row.
    float state_local[CS];
    for (uint i = 0; i < CS; ++i) {
        const uint col = NUM_GROUPS * i + col_group;
        state_local[i] = state_in[state_base + col * S_V + row_out];
    }

    for (uint t = 0; t < p.n_tokens; ++t) {
        // Cooperative load of the current token's q/k. q is pre-scaled so the
        // recurrent math matches the CPU/CUDA kernels (q/k are already L2-normed).
        s_k[tid] = k[q_base + t * S_V + tid];
        s_q[tid] = q[q_base + t * S_V + tid] * p.scale;

        // attn = sum_i k[i] * (q[i] * scale)
        s_red[tid] = s_k[tid] * s_q[tid];
        barrier();
        for (uint s = S_V / 2u; s > 0u; s >>= 1u) {
            if (tid < s) {
                s_red[tid] += s_red[tid + s];
            }
            barrier();
        }
        const float attn = s_red[0];

        const float beta_val = 1.0f / (1.0f + exp(-b[gb_base + t * p.H_v]));
        const float decay = exp(min(g[gb_base + t * p.H_v], 50.0f));

        // Partial sums over this thread's columns.
        float v_prime = 0.0f;
        float out_val = 0.0f;
        for (uint i = 0; i < CS; ++i) {
            const uint col = NUM_GROUPS * i + col_group;
            v_prime += state_local[i] * s_k[col];
            out_val  += state_local[i] * s_q[col];
        }

        all_sum1[col_group * (CS + 1u) + row] = v_prime;
        all_sum2[col_group * (CS + 1u) + row] = out_val;
        barrier();

        // Reduce across column groups.
        v_prime = 0.0f;
        out_val = 0.0f;
        for (uint grp = 0; grp < NUM_GROUPS; ++grp) {
            v_prime += all_sum1[grp * (CS + 1u) + row];
            out_val  += all_sum2[grp * (CS + 1u) + row];
        }

        const float v_val = v[v_base + t * p.v_nb1 + row_out];
        const float v_new = beta_val * (v_val - v_prime * decay);

        if (col_group == 0u) {
            dst[out_base + t * out_token_stride + row_out] = out_val * decay + v_new * attn;
        }

        for (uint i = 0; i < CS; ++i) {
            const uint col = NUM_GROUPS * i + col_group;
            const float s_new = decay * state_local[i] + v_new * s_k[col];
            state_local[i] = clamp(s_new, -1e6f, 1e6f);
        }

        if (p.has_saved != 0u && t + 1u < p.n_tokens) {
            const uint saved_base = t * (S_V * S_V * p.H_v * p.n_seqs) + state_base;
            for (uint i = 0; i < CS; ++i) {
                const uint col = NUM_GROUPS * i + col_group;
                saved[saved_base + col * S_V + row_out] = state_local[i];
            }
        }

        barrier();
    }

    const uint output_size = S_V * p.H_v * p.n_tokens * p.n_seqs;
    const uint state_out_base = output_size + state_base;
    for (uint i = 0; i < CS; ++i) {
        const uint col = NUM_GROUPS * i + col_group;
        dst[state_out_base + col * S_V + row_out] = state_local[i];
    }
}
