#version 450

#include "dequant_head.comp"
#include "iqk_tables.comp"
#include "dequant_iqk_common.comp"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

#define QUANT_K 256
#define BLOCK_BYTES 100
#define META 4

void main() {
    const uint ib = gl_WorkGroupID.x * 32 + gl_LocalInvocationID.x / 8;
    const uint ib32 = gl_LocalInvocationID.x % 8;

    if (ib >= p.nel / QUANT_K) {
        return;
    }

    const uint nbpb = p.K;
    const uint meta = p.stride_a;
    const uint row_bytes = meta + nbpb * BLOCK_BYTES;
    const uint row = ib / nbpb;
    const uint block_byte = row * row_bytes + META + (ib % nbpb) * BLOCK_BYTES;

    const float d = uintBitsToFloat(data_a32[(row * row_bytes) / 4]);
    const uint sc = data_a32[block_byte / 4];
    const uint ql0 = data_a32[(block_byte + 4) / 4 + 2 * ib32];
    const uint ql1 = data_a32[(block_byte + 4) / 4 + 2 * ib32 + 1];
    const uint qh_dw = (block_byte + 68) / 4;
    const uint b_idx = QUANT_K * ib + 32 * ib32;

    const uint sc_byte = (sc >> (8 * (ib32 % 4))) & 0xffu;
    const float dl = d * 1.01f * float((sc_byte >> (4 * (ib32 / 4))) & 0xFu);

    [[unroll]] for (uint j = 0; j < 4; ++j) {
        const uint q16 = (j < 2 ? ql0 : ql1) >> (16 * (j & 1));
        uint x = (q16 & 0xffffu) + 4096u;
        const uint h0 = data_a32[qh_dw + 2 * j];
        const uint h1 = data_a32[qh_dw + 2 * j + 1];

        uint sign0 = 0u;
        uint sign1 = 0u;
        [[unroll]] for (uint k = 0; k < 4; ++k) {
            sign0 |= (((h0 >> (8 * k)) >> ib32) & 1u) << k;
            sign1 |= (((h1 >> (8 * k)) >> ib32) & 1u) << k;
        }

        const vec4 v0 = iqk_hash_values(x, true, sign0);
        const vec4 v1 = iqk_hash_values(x, true, sign1);
        iqk_store4(b_idx + 8 * j,     dl * v0);
        iqk_store4(b_idx + 8 * j + 4, dl * v1);
    }
}
