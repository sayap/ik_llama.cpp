#version 450

#include "dequant_head.comp"
#include "iqk_tables.comp"
#include "dequant_iqk_common.comp"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

#define QUANT_K 256
#define BLOCK_BYTES 128
#define META 4

void main() {
    // 64 threads per block: thread (g, j) decodes the 4 elements of
    // sub-block g (of 8), byte j (of 8). One hash chain and one f16vec4
    // output per thread keeps the register footprint minimal.
    const uint ib = gl_WorkGroupID.x * 4 + gl_LocalInvocationID.x / 64;
    const uint g  = (gl_LocalInvocationID.x % 64) / 8;
    const uint j  = gl_LocalInvocationID.x % 8;

    if (ib >= p.nel / QUANT_K) {
        return;
    }

    const uint nbpb = p.K;
    const uint meta = p.stride_a;
    const uint row_bytes = meta + nbpb * BLOCK_BYTES;
    const uint row = ib / nbpb;
    const uint block_byte = row * row_bytes + META + (ib % nbpb) * BLOCK_BYTES;

    const float d = uintBitsToFloat(data_a32[(row * row_bytes) / 4]);
    const uint qs32 = data_a32[(block_byte + 4 * g) / 4];
    const float dl = d * (float((qs32 & 0xffu) >> 1) - 64.0f);
    const uint idx0 = ((qs32 & 1u) << 15) + 4096u;

    const uint b_idx = QUANT_K * ib + 32 * g + 4 * j;

    const uint ql_dw = data_a32[(block_byte + 32 + 8 * g) / 4 + (j / 4)];
    const uint qh_dw = data_a32[(block_byte + 96 + 8 * (g % 4)) / 4 + (j / 4)];
    const uint sh_shift = 8 - 4 * (g / 4);

    const uint qlb = (ql_dw >> (8 * (j & 3))) & 0xffu;
    const uint qhb = (qh_dw >> (8 * (j & 3))) & 0xffu;
    uint x = qlb
           + ((qhb << sh_shift) & 0xf00u)
           + ((qs32 >> (8 + 3 * j)) & 7u) * 4096u
           + idx0;
    const vec4 v = iqk_hash_values(x, false, 0u);
    iqk_store4(b_idx, dl * v);
}
