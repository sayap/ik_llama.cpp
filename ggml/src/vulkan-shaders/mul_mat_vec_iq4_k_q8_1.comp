#version 450

#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

#include "mul_mat_vec_iqk_base_q8_1.comp"

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

// uint32 view of the byte-addressed weight buffer (IQ4_K has no row meta and a
// 144-byte block, so every block/field offset here is 4-byte aligned).
layout (binding = 0) readonly buffer A32 { uint data_a32[]; };

#define QUANT_K 256
#define BLOCK_BYTES 144

// Combined byte-pair table: entry[q] packs iq4k_values[v1*16 + (q & 0xf)] (low
// byte) and iq4k_values[v2*16 + (q >> 4)] (high byte), so IQ4_K's two table
// selectors are one shared load per quantized byte.
shared uint iq4k_pair_shmem[4][256];

uint iq4k_pair_entry(uint sel, uint q) {
    return iq4k_pair_shmem[sel][q];
}

FLOAT_TYPE temp[NUM_COLS][NUM_ROWS];

void calc_superblock(const uint a_byte, const uint b_offset, const uint itid, const uint i,
                     const uint num_blocks_per_row, const uint first_row, const uint num_rows) {
    // 8 threads per block, CUDA-style vec_dot_iq4_k_q8_1: thread ib32 handles a
    // full 32-element group — the low qs nibbles (16 elements, scale dl1, value
    // table v1_sel) dot against the first half of Q8_1 block ib32, the high qs
    // nibbles (16 elements, scale dl2, table v2_sel) against the second half.
    const uint ib32 = itid;    // 0..7

    const uint row_bytes = p.stride_a + num_blocks_per_row * BLOCK_BYTES;

    [[unroll]] for (uint n = 0; n < num_rows; ++n) {
        const uint block_dw = (a_byte + (first_row + n) * row_bytes + p.stride_a + i * BLOCK_BYTES) >> 2;

        const uint head = data_a32[block_dw];
        const float d = iqk_f16_to_f32(head & 0xffffu);
        const uint extra16 = head >> 16;
        const uint extra_shift = extra16 >> (2 * ib32);
        const uint v1_sel = (extra_shift & 1u) != 0 ? 1 : 0;
        const uint v2_sel = (extra_shift & 2u) != 0 ? 1 : 0;
        const uint pair_sel = 2 * v1_sel + v2_sel;

        // sub-block scales: ls1 for the low-nibble group, ls2 for the high-nibble group
        const uint sh_byte = (data_a32[block_dw + 1] >> (8 * (ib32 / 2))) & 0xffu;
        const uint sh = sh_byte >> (4 * (ib32 % 2));
        const uint sl = (data_a32[block_dw + 2 + (ib32 >> 2)] >> (8 * (ib32 % 4))) & 0xffu;
        const int ls1 = int((sl & 0xFu) | ((sh << 4) & 0x30u)) - 32;
        const int ls2 = int((sl >> 4) | ((sh << 2) & 0x30u)) - 32;
        const float dl1 = d * float(ls1);
        const float dl2 = d * float(ls2);

        // qs starts at offset 16; each 32-element group is 16 bytes = 4 uint32.
        const uint qs_dw = block_dw + 4 + 4 * ib32;
        const uint w0 = data_a32[qs_dw + 0];
        const uint w1 = data_a32[qs_dw + 1];
        const uint w2 = data_a32[qs_dw + 2];
        const uint w3 = data_a32[qs_dw + 3];

        [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
            const uint b8 = (j * p.batch_stride_b + b_offset + i * QUANT_K) / 32 + ib32;
            const vec2 ds = vec2(data_b[b8].ds);
            const float d8 = ds.x;

            int sumi1 = 0;
            int sumi2 = 0;
            [[unroll]] for (uint g = 0; g < 4; ++g) {
                const uint w = (g == 0) ? w0 : (g == 1) ? w1 : (g == 2) ? w2 : w3;
                int packed_lo = 0;
                int packed_hi = 0;
                [[unroll]] for (uint k = 0; k < 4; ++k) {
                    const uint q = (w >> (8 * k)) & 0xffu;
                    const uint e = iq4k_pair_entry(pair_sel, q);
                    packed_lo |= int(e & 0xffu) << (8 * k);
                    packed_hi |= int((e >> 8) & 0xffu) << (8 * k);
                }
                sumi1 += dotPacked4x8EXT(packed_lo, data_b[b8].qs[g]);
                sumi2 += dotPacked4x8EXT(packed_hi, data_b[b8].qs[g + 4]);
            }

            temp[j][n] = fma(dl1 * d8, float(sumi1), temp[j][n]);
            temp[j][n] = fma(dl2 * d8, float(sumi2), temp[j][n]);
        }
    }
}

void compute_outputs(const uint32_t first_row, const uint32_t num_rows) {
    uint a_byte, b_offset, d_offset;
    get_offsets(a_byte, b_offset, d_offset);

    const uint num_blocks_per_row = p.ncols / QUANT_K;

    const uint blocks_per_wg = gl_WorkGroupSize.x / 8;
    const uint tid = gl_LocalInvocationID.x;
    const uint itid = tid % 8;
    const uint ix = tid / 8;

    [[unroll]] for (uint idx = tid; idx < 128; idx += BLOCK_SIZE) {
        const uint b0 = iq4k_values_byte_0[idx];
        const uint b16 = iq4k_values_byte_16[idx];
        // sel = v1*2 + v2; combined byte-pair = lo nibble from table v1, hi from v2.
        // b0/b16 each pack two 16-bit byte-pairs (bytes 2*idx and 2*idx+1).
        const uint c00 = (b0 & 0xffu) | (b0 & 0xff00u);
        const uint c01 = (b0 & 0xffu) | (b16 & 0xff00u);
        const uint c10 = (b16 & 0xffu) | (b0 & 0xff00u);
        const uint c11 = (b16 & 0xffu) | (b16 & 0xff00u);
        const uint d00 = ((b0 >> 16) & 0xffu) | ((b0 >> 16) & 0xff00u);
        const uint d01 = ((b0 >> 16) & 0xffu) | ((b16 >> 16) & 0xff00u);
        const uint d10 = ((b16 >> 16) & 0xffu) | ((b0 >> 16) & 0xff00u);
        const uint d11 = ((b16 >> 16) & 0xffu) | ((b16 >> 16) & 0xff00u);
        iq4k_pair_shmem[0][2*idx]     = c00;
        iq4k_pair_shmem[0][2*idx + 1] = d00;
        iq4k_pair_shmem[1][2*idx]     = c01;
        iq4k_pair_shmem[1][2*idx + 1] = d01;
        iq4k_pair_shmem[2][2*idx]     = c10;
        iq4k_pair_shmem[2][2*idx + 1] = d10;
        iq4k_pair_shmem[3][2*idx]     = c11;
        iq4k_pair_shmem[3][2*idx + 1] = d11;
    }
    barrier();

    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        [[unroll]] for (uint i = 0; i < NUM_ROWS; ++i) {
            temp[j][i] = FLOAT_TYPE(0);
        }
    }

    [[unroll]] for (uint i = ix; i < num_blocks_per_row; i += blocks_per_wg)
        calc_superblock(a_byte, b_offset, itid, i, num_blocks_per_row, first_row, num_rows);

    reduce_result(temp, d_offset, first_row, num_rows, tid);
}

void main() {
    const uint first_row = NUM_ROWS * (gl_WorkGroupID.x + gl_NumWorkGroups.x * gl_WorkGroupID.z);

    if (first_row + NUM_ROWS <= p.stride_d) {
        compute_outputs(first_row, NUM_ROWS);
    } else {
        if (first_row >= p.stride_d) {
            return;
        }
        compute_outputs(first_row, p.stride_d - first_row);
    }
}
