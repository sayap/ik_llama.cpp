#version 450

#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

#include "mul_mat_vec_iqk_base_q8_1.comp"

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

// uint32 view of the byte-addressed weight buffer (IQ3_KT has a 4-byte row
// scale header and 100-byte blocks, so every row/block/field offset here is
// 4-byte aligned).
layout (binding = 0) readonly buffer A32 { uint data_a32[]; };

#define QUANT_K 256
#define BLOCK_BYTES 100
#define META 4

FLOAT_TYPE temp[NUM_COLS][NUM_ROWS];

// Pack the four per-byte sign bits (bit ib32 of each byte) of a qh uint32
// into a 4-bit sign mask for iqk_hash_values_packed.
uint iq3kt_sign_mask(uint qh_word, uint ib32) {
    const uint sbits = (qh_word >> ib32) & 0x01010101u;
    return (sbits & 1u) | ((sbits >> 7) & 2u) | ((sbits >> 14) & 4u) | ((sbits >> 21) & 8u);
}

void calc_superblock(const uint a_byte, const uint b_offset, const uint itid, const uint i,
                     const uint num_blocks_per_row, const uint first_row, const uint num_rows) {
    // 8 threads per block, CUDA-style vec_dot_iq3_kt_q8_1: thread ib32 handles
    // a full 32-element Q8_1 block — four uint16 ql values, eight hash rounds
    // with abs + per-value sign from the qh bytes.
    const uint ib32 = itid;    // 0..7

    const uint row_bytes = p.stride_a + num_blocks_per_row * BLOCK_BYTES;

    [[unroll]] for (uint n = 0; n < num_rows; ++n) {
        const uint row_byte = a_byte + (first_row + n) * row_bytes;
        const uint block_dw = (row_byte + META + i * BLOCK_BYTES) >> 2;

        const float d = uintBitsToFloat(data_a32[row_byte >> 2]);

        // scales[4] at block offset 0: raw 4-bit scale value.
        const uint sc = (data_a32[block_dw] >> (8 * (ib32 % 4))) & 0xffu;
        const float dl = d * 1.01f * float((sc >> (4 * (ib32 / 4))) & 0xFu);

        // ql starts at offset 4 (64 bytes = 32 uint16); four uint16 per thread.
        const uint ql_dw = block_dw + 1 + 2 * ib32;
        const uint ql0 = data_a32[ql_dw];
        const uint ql1 = data_a32[ql_dw + 1];

        // qh at offset 68 (32 bytes = 8 uint32): per-value sign bit ib32.
        const uint qh_dw = block_dw + 17;
        const uint qh0 = data_a32[qh_dw + 0];
        const uint qh1 = data_a32[qh_dw + 1];
        const uint qh2 = data_a32[qh_dw + 2];
        const uint qh3 = data_a32[qh_dw + 3];
        const uint qh4 = data_a32[qh_dw + 4];
        const uint qh5 = data_a32[qh_dw + 5];
        const uint qh6 = data_a32[qh_dw + 6];
        const uint qh7 = data_a32[qh_dw + 7];

        [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
            const uint b8 = (j * p.batch_stride_b + b_offset + i * QUANT_K) / 32 + ib32;
            const vec2 ds = vec2(data_b[b8].ds);
            const float d8 = ds.x;

            uint x0 = (ql0 & 0xffffu) + 4096u;
            const int v00 = iqk_hash_values_packed(x0, true, iq3kt_sign_mask(qh0, ib32));
            const int v01 = iqk_hash_values_packed(x0, true, iq3kt_sign_mask(qh1, ib32));
            uint x1 = (ql0 >> 16) + 4096u;
            const int v10 = iqk_hash_values_packed(x1, true, iq3kt_sign_mask(qh2, ib32));
            const int v11 = iqk_hash_values_packed(x1, true, iq3kt_sign_mask(qh3, ib32));
            uint x2 = (ql1 & 0xffffu) + 4096u;
            const int v20 = iqk_hash_values_packed(x2, true, iq3kt_sign_mask(qh4, ib32));
            const int v21 = iqk_hash_values_packed(x2, true, iq3kt_sign_mask(qh5, ib32));
            uint x3 = (ql1 >> 16) + 4096u;
            const int v30 = iqk_hash_values_packed(x3, true, iq3kt_sign_mask(qh6, ib32));
            const int v31 = iqk_hash_values_packed(x3, true, iq3kt_sign_mask(qh7, ib32));

            int sumi = 0;
            sumi += dotPacked4x8EXT(v00, data_b[b8].qs[0]);
            sumi += dotPacked4x8EXT(v01, data_b[b8].qs[1]);
            sumi += dotPacked4x8EXT(v10, data_b[b8].qs[2]);
            sumi += dotPacked4x8EXT(v11, data_b[b8].qs[3]);
            sumi += dotPacked4x8EXT(v20, data_b[b8].qs[4]);
            sumi += dotPacked4x8EXT(v21, data_b[b8].qs[5]);
            sumi += dotPacked4x8EXT(v30, data_b[b8].qs[6]);
            sumi += dotPacked4x8EXT(v31, data_b[b8].qs[7]);

            temp[j][n] = fma(dl * d8, float(sumi), temp[j][n]);
        }
    }
}

void compute_outputs(const uint32_t first_row, const uint32_t num_rows) {
    uint a_byte, b_offset, d_offset;
    get_offsets(a_byte, b_offset, d_offset);

    const uint num_blocks_per_row = p.ncols / QUANT_K;

    const uint blocks_per_wg = gl_WorkGroupSize.x / 8;
    const uint tid = gl_LocalInvocationID.x;
    const uint itid = tid % 8;
    const uint ix = tid / 8;

    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        [[unroll]] for (uint i = 0; i < NUM_ROWS; ++i) {
            temp[j][i] = FLOAT_TYPE(0);
        }
    }

    [[unroll]] for (uint i = ix; i < num_blocks_per_row; i += blocks_per_wg)
        calc_superblock(a_byte, b_offset, itid, i, num_blocks_per_row, first_row, num_rows);

    reduce_result(temp, d_offset, first_row, num_rows, tid);
}

void main() {
    const uint first_row = NUM_ROWS * (gl_WorkGroupID.x + gl_NumWorkGroups.x * gl_WorkGroupID.z);

    if (first_row + NUM_ROWS <= p.stride_d) {
        compute_outputs(first_row, NUM_ROWS);
    } else {
        if (first_row >= p.stride_d) {
            return;
        }
        compute_outputs(first_row, p.stride_d - first_row);
    }
}
