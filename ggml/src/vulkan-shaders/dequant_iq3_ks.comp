#version 450

#include "dequant_head.comp"
#include "iqk_tables.comp"
#include "dequant_iqk_common.comp"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

#define QUANT_K 256
#define BLOCK_BYTES 102
#define META 2

vec4 iq3ks_unpack(uint qw, uint hw, uint shift_q, uint shift_h, uint vo) {
    return vec4(
        float(iq3nl_values[((((qw & 0xffu) >> shift_q) & 3u) | (((hw & 0xffu) >> shift_h & 1u) << 2)) + vo]),
        float(iq3nl_values[((((qw >> 8 & 0xffu) >> shift_q) & 3u) | (((hw >> 8 & 0xffu) >> shift_h & 1u) << 2)) + vo]),
        float(iq3nl_values[((((qw >> 16 & 0xffu) >> shift_q) & 3u) | (((hw >> 16 & 0xffu) >> shift_h & 1u) << 2)) + vo]),
        float(iq3nl_values[((((qw >> 24 & 0xffu) >> shift_q) & 3u) | (((hw >> 24 & 0xffu) >> shift_h & 1u) << 2)) + vo]));
}

void main() {
    const uint tid = gl_LocalInvocationID.x;
    // 64 threads per block: thread (k, j) decodes one vec4.
    const uint ib = gl_WorkGroupID.x * 4 + tid / 64;
    const uint k = (tid % 64) / 8;
    const uint j = tid % 8;

    if (ib >= p.nel / QUANT_K) {
        return;
    }

    const uint nbpb = p.K;
    const uint meta = p.stride_a;
    const uint row_bytes = meta + nbpb * BLOCK_BYTES;
    const uint row = ib / nbpb;
    const uint block_byte = row * row_bytes + META + (ib % nbpb) * BLOCK_BYTES;

    const float d = iqk_f16_to_f32(iqk_load_u16(row * row_bytes));
    const uint extra = iqk_load_u16(block_byte);
    const uint b_idx = QUANT_K * ib + 32 * k + 4 * j;

    const uint sc = (data_a[block_byte + 2 + k % 4] >> (4 * (k / 4))) & 0xFu;
    const float dl = d * (float(sc | (((extra >> k) & 1u) << 4)) - 16.0f);
    const uint v_off = ((extra >> (8 + k)) & 1u) != 0 ? 8u : 0u;
    const uint shift_q = 2 * (k % 4);
    const uint shift_h = k;
    const uint qs_base = block_byte + 6 + 32 * (k / 4);
    const uint qh_base = block_byte + 70;

    iqk_store4(b_idx, dl * iq3ks_unpack(iqk_load_u32a(qs_base + 4 * j), iqk_load_u32a(qh_base + 4 * j), shift_q, shift_h, v_off));
}
