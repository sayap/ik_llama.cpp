#version 450

#include "dequant_head.comp"
#include "iqk_tables.comp"
#include "dequant_iqk_common.comp"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

#define QUANT_K 256
#define BLOCK_BYTES 76

vec4 iq2k_unpack(uint w, uint shift, uint vo) {
    return vec4(
        float(iq2nl_values[(((w & 0xffu) >> shift) & 3u) + vo]),
        float(iq2nl_values[((((w >> 8) & 0xffu) >> shift) & 3u) + vo]),
        float(iq2nl_values[((((w >> 16) & 0xffu) >> shift) & 3u) + vo]),
        float(iq2nl_values[((((w >> 24) & 0xffu) >> shift) & 3u) + vo]));
}

void main() {
    // 32 threads per block: thread (g, j) decodes the low- and high-half
    // vec4s of sub-block g (of 8), qs dword j (of 4).
    const uint ib = gl_WorkGroupID.x * 8 + gl_LocalInvocationID.x / 32;
    const uint g  = (gl_LocalInvocationID.x % 32) / 4;
    const uint j  = gl_LocalInvocationID.x % 4;

    if (ib >= p.nel / QUANT_K) {
        return;
    }

    const uint nbpb = p.K;
    const uint meta = p.stride_a;
    const uint row_bytes = meta + nbpb * BLOCK_BYTES;
    const uint block_byte = (ib / nbpb) * row_bytes + meta + (ib % nbpb) * BLOCK_BYTES;

    const uint dw = block_byte / 4;
    const uint head = data_a32[dw];
    const float d = iqk_f16_to_f32(head & 0xffffu);
    const uint extra = head >> 16;
    const uint sc01 = data_a32[dw + 1];
    const uint sc23 = data_a32[dw + 2];
    const uint b_idx = QUANT_K * ib + 32 * g + 4 * j;

    const uint shift = 2 * (g % 4);
    const uint sc = (g < 4 ? sc01 : sc23) >> (8 * (g & 3));
    const float dl1 = d * (float(sc & 0xFu) - 8.0f);
    const float dl2 = d * (float((sc >> 4) & 0xFu) - 8.0f);
    const uint e = extra >> (2 * g);
    const uint v1_off = (e & 1u) != 0 ? 4u : 0u;
    const uint v2_off = (e & 2u) != 0 ? 4u : 0u;
    const uint qs_dw = (block_byte + 12 + (g / 4) * 32) / 4;

    iqk_store4(b_idx,      dl1 * iq2k_unpack(data_a32[qs_dw + j],     shift, v1_off));
    iqk_store4(b_idx + 16, dl2 * iq2k_unpack(data_a32[qs_dw + 4 + j], shift, v2_off));
}
