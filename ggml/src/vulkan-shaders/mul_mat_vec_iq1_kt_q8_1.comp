#version 450

#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

#include "mul_mat_vec_iqk_base_q8_1.comp"

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

// uint32 view of the byte-addressed weight buffer (IQ1_KT has a 4-byte row
// scale header and 56-byte blocks, so every row/block/field offset here is
// 4-byte aligned).
layout (binding = 0) readonly buffer A32 { uint data_a32[]; };

#define QUANT_K 256
#define BLOCK_BYTES 56
#define META 4

FLOAT_TYPE temp[NUM_COLS][NUM_ROWS];

void calc_superblock(const uint a_byte, const uint b_offset, const uint itid, const uint i,
                     const uint num_blocks_per_row, const uint first_row, const uint num_rows) {
    // 8 threads per block, CUDA-style vec_dot_iq1_kt_q8_1: thread ib32 handles
    // a full 32-element Q8_1 block — four ql bytes (with qh and sh bits folded
    // in), eight hash rounds dotted against the block's eight int32 words.
    const uint ib32 = itid;    // 0..7

    const uint row_bytes = p.stride_a + num_blocks_per_row * BLOCK_BYTES;

    [[unroll]] for (uint n = 0; n < num_rows; ++n) {
        const uint row_byte = a_byte + (first_row + n) * row_bytes;
        const uint block_dw = (row_byte + META + i * BLOCK_BYTES) >> 2;

        const float d = uintBitsToFloat(data_a32[row_byte >> 2]);

        // sh[8] at block offset 0: low nibble is the scale, high nibble the
        // per-group sign bits.
        const uint sh_byte = (data_a32[block_dw + (ib32 >> 2)] >> (8 * (ib32 & 3))) & 0xffu;
        const float dl = d * float(iq4k_values[sh_byte & 0xFu]);

        // ql[32] at offset 8 (4 bytes per thread), qh[16] at offset 40.
        const uint ql_word = data_a32[block_dw + 2 + ib32];
        const uint qh_word = data_a32[block_dw + 10 + (ib32 & 3)];
        const uint qshift = 8 - 4 * (ib32 / 4);

        const uint ql0 = ql_word & 0xffu;
        const uint ql1 = (ql_word >> 8) & 0xffu;
        const uint ql2 = (ql_word >> 16) & 0xffu;
        const uint ql3 = (ql_word >> 24) & 0xffu;
        const uint qh0 = qh_word & 0xffu;
        const uint qh1 = (qh_word >> 8) & 0xffu;
        const uint qh2 = (qh_word >> 16) & 0xffu;
        const uint qh3 = (qh_word >> 24) & 0xffu;

        [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
            const uint b8 = (j * p.batch_stride_b + b_offset + i * QUANT_K) / 32 + ib32;
            const vec2 ds = vec2(data_b[b8].ds);
            const float d8 = ds.x;

            uint x0 = ql0 + 4096u + ((qh0 << qshift) & 0xf00u) + ((sh_byte << 8) & 0x1000u);
            const int v00 = iqk_hash_values_packed(x0, false, 0u);
            const int v01 = iqk_hash_values_packed(x0, false, 0u);
            uint x1 = ql1 + 4096u + ((qh1 << qshift) & 0xf00u) + ((sh_byte << 7) & 0x1000u);
            const int v10 = iqk_hash_values_packed(x1, false, 0u);
            const int v11 = iqk_hash_values_packed(x1, false, 0u);
            uint x2 = ql2 + 4096u + ((qh2 << qshift) & 0xf00u) + ((sh_byte << 6) & 0x1000u);
            const int v20 = iqk_hash_values_packed(x2, false, 0u);
            const int v21 = iqk_hash_values_packed(x2, false, 0u);
            uint x3 = ql3 + 4096u + ((qh3 << qshift) & 0xf00u) + ((sh_byte << 5) & 0x1000u);
            const int v30 = iqk_hash_values_packed(x3, false, 0u);
            const int v31 = iqk_hash_values_packed(x3, false, 0u);

            int sumi = 0;
            sumi += dotPacked4x8EXT(v00, data_b[b8].qs[0]);
            sumi += dotPacked4x8EXT(v01, data_b[b8].qs[1]);
            sumi += dotPacked4x8EXT(v10, data_b[b8].qs[2]);
            sumi += dotPacked4x8EXT(v11, data_b[b8].qs[3]);
            sumi += dotPacked4x8EXT(v20, data_b[b8].qs[4]);
            sumi += dotPacked4x8EXT(v21, data_b[b8].qs[5]);
            sumi += dotPacked4x8EXT(v30, data_b[b8].qs[6]);
            sumi += dotPacked4x8EXT(v31, data_b[b8].qs[7]);

            temp[j][n] = fma(dl * d8, float(sumi), temp[j][n]);
        }
    }
}

void compute_outputs(const uint32_t first_row, const uint32_t num_rows) {
    uint a_byte, b_offset, d_offset;
    get_offsets(a_byte, b_offset, d_offset);

    const uint num_blocks_per_row = p.ncols / QUANT_K;

    const uint blocks_per_wg = gl_WorkGroupSize.x / 8;
    const uint tid = gl_LocalInvocationID.x;
    const uint itid = tid % 8;
    const uint ix = tid / 8;

    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        [[unroll]] for (uint i = 0; i < NUM_ROWS; ++i) {
            temp[j][i] = FLOAT_TYPE(0);
        }
    }

    [[unroll]] for (uint i = ix; i < num_blocks_per_row; i += blocks_per_wg)
        calc_superblock(a_byte, b_offset, itid, i, num_blocks_per_row, first_row, num_rows);

    reduce_result(temp, d_offset, first_row, num_rows, tid);
}

void main() {
    const uint first_row = NUM_ROWS * (gl_WorkGroupID.x + gl_NumWorkGroups.x * gl_WorkGroupID.z);

    if (first_row + NUM_ROWS <= p.stride_d) {
        compute_outputs(first_row, NUM_ROWS);
    } else {
        if (first_row >= p.stride_d) {
            return;
        }
        compute_outputs(first_row, p.stride_d - first_row);
    }
}
