#version 450

#include "dequant_head.comp"
#include "iqk_tables.comp"
#include "dequant_iqk_common.comp"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

#define QUANT_K 256
#define BLOCK_BYTES 212

// part 0: 4-bit low nibbles, 2 high bits from h
vec4 iq6k_lo(uint qw, uint hw, uint shift, uint vo) {
    return vec4(
        float(iq6nl_values[((qw & 0xFu) | ((((hw & 0xffu) >> shift) & 3u) << 4)) + vo]),
        float(iq6nl_values[((((qw >> 8) & 0xFu) | ((((hw >> 8) & 0xffu) >> shift & 3u) << 4))) + vo]),
        float(iq6nl_values[((((qw >> 16) & 0xFu) | ((((hw >> 16) & 0xffu) >> shift & 3u) << 4))) + vo]),
        float(iq6nl_values[((((qw >> 24) & 0xFu) | ((((hw >> 24) & 0xffu) >> shift & 3u) << 4))) + vo]));
}

// part 1: 4-bit high nibbles, 2 high bits from h
vec4 iq6k_hi(uint qw, uint hw, uint shift, uint vo) {
    return vec4(
        float(iq6nl_values[((((qw >> 4) & 0xFu) | ((((hw & 0xffu) >> shift) & 0xcu) << 2))) + vo]),
        float(iq6nl_values[((((qw >> 12) & 0xFu) | ((((hw >> 8) & 0xffu) >> shift & 0xcu) << 2))) + vo]),
        float(iq6nl_values[((((qw >> 20) & 0xFu) | ((((hw >> 16) & 0xffu) >> shift & 0xcu) << 2))) + vo]),
        float(iq6nl_values[((((qw >> 28) & 0xFu) | ((((hw >> 24) & 0xffu) >> shift & 0xcu) << 2))) + vo]));
}

void main() {
    const uint ib = gl_WorkGroupID.x * 32 + gl_LocalInvocationID.x / 8;
    const uint ib64 = gl_LocalInvocationID.x % 4;
    const uint part = (gl_LocalInvocationID.x % 8) / 4;

    if (ib >= p.nel / QUANT_K) {
        return;
    }

    const uint nbpb = p.K;
    const uint meta = p.stride_a;
    const uint row_bytes = meta + nbpb * BLOCK_BYTES;
    const uint block_byte = (ib / nbpb) * row_bytes + meta + (ib % nbpb) * BLOCK_BYTES;

    const uint dw = block_byte / 4;
    const uint head = data_a32[dw];
    const float d = iqk_f16_to_f32(head & 0xffffu);
    const uint extra = head >> 16;
    const uint sc = data_a32[dw + 1 + ib64];
    const uint b_idx = QUANT_K * ib + 64 * ib64 + 32 * part;

    const uint shift = 4 * (ib64 % 2);
    const uint e = extra >> (4 * ib64);
    const uint qs_dw = (block_byte + 20 + 32 * ib64) / 4;
    const uint qh_dw = (block_byte + 148 + 32 * (ib64 / 2)) / 4;

    if (part == 0) {
        const float dl1 = d * float(int8_t(sc & 0xffu));
        const float dl2 = d * float(int8_t((sc >> 8) & 0xffu));
        const uint v1_off = (e & 1u) != 0 ? 64u : 0u;
        const uint v2_off = (e & 2u) != 0 ? 64u : 0u;
        [[unroll]] for (uint j = 0; j < 4; ++j) {
            iqk_store4(b_idx + 4 * j,      dl1 * iq6k_lo(data_a32[qs_dw + j],     data_a32[qh_dw + j],     shift, v1_off));
            iqk_store4(b_idx + 16 + 4 * j, dl2 * iq6k_lo(data_a32[qs_dw + 4 + j], data_a32[qh_dw + 4 + j], shift, v2_off));
        }
    } else {
        const float dl1 = d * float(int8_t((sc >> 16) & 0xffu));
        const float dl2 = d * float(int8_t((sc >> 24) & 0xffu));
        const uint v1_off = (e & 4u) != 0 ? 64u : 0u;
        const uint v2_off = (e & 8u) != 0 ? 64u : 0u;
        [[unroll]] for (uint j = 0; j < 4; ++j) {
            iqk_store4(b_idx + 4 * j,      dl1 * iq6k_hi(data_a32[qs_dw + j],     data_a32[qh_dw + j],     shift, v1_off));
            iqk_store4(b_idx + 16 + 4 * j, dl2 * iq6k_hi(data_a32[qs_dw + 4 + j], data_a32[qh_dw + 4 + j], shift, v2_off));
        }
    }
}
