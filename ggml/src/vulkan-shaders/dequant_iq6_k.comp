#version 450

#include "dequant_head.comp"
#include "iqk_tables.comp"
#include "dequant_iqk_common.comp"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

#define QUANT_K 256
#define BLOCK_BYTES 212

// Value table staged in shared memory: entry i = iq6nl_values[i].
shared int8_t iq6k_tbl[128];

// part 0: 4-bit low nibbles, 2 high bits from h
vec4 iq6k_lo(uint qw, uint hw, uint shift, uint vo) {
    return vec4(
        float(iq6k_tbl[((qw & 0xFu) | ((((hw & 0xffu) >> shift) & 3u) << 4)) + vo]),
        float(iq6k_tbl[((((qw >> 8) & 0xFu) | ((((hw >> 8) & 0xffu) >> shift & 3u) << 4))) + vo]),
        float(iq6k_tbl[((((qw >> 16) & 0xFu) | ((((hw >> 16) & 0xffu) >> shift & 3u) << 4))) + vo]),
        float(iq6k_tbl[((((qw >> 24) & 0xFu) | ((((hw >> 24) & 0xffu) >> shift & 3u) << 4))) + vo]));
}

// part 1: 4-bit high nibbles, 2 high bits from h
vec4 iq6k_hi(uint qw, uint hw, uint shift, uint vo) {
    return vec4(
        float(iq6k_tbl[((((qw >> 4) & 0xFu) | ((((hw & 0xffu) >> shift) & 0xcu) << 2))) + vo]),
        float(iq6k_tbl[((((qw >> 12) & 0xFu) | ((((hw >> 8) & 0xffu) >> shift & 0xcu) << 2))) + vo]),
        float(iq6k_tbl[((((qw >> 20) & 0xFu) | ((((hw >> 16) & 0xffu) >> shift & 0xcu) << 2))) + vo]),
        float(iq6k_tbl[((((qw >> 28) & 0xFu) | ((((hw >> 24) & 0xffu) >> shift & 0xcu) << 2))) + vo]));
}

void main() {
    const uint tid = gl_LocalInvocationID.x;
    [[unroll]] for (uint idx = tid; idx < 128; idx += 256) {
        iq6k_tbl[idx] = iq6nl_values[idx];
    }
    barrier();

    // 64 threads per block: thread (ib64, part, t) decodes one vec4;
    // t < 4 is the low 16 elements (qs dwords j = t), t >= 4 the high 16
    // (qs dwords 4 + j).
    const uint ib = gl_WorkGroupID.x * 4 + tid / 64;
    const uint ib64 = (tid % 64) / 16;
    const uint part = (tid % 16) / 8;
    const uint t = tid % 8;

    if (ib >= p.nel / QUANT_K) {
        return;
    }

    const uint nbpb = p.K;
    const uint meta = p.stride_a;
    const uint row_bytes = meta + nbpb * BLOCK_BYTES;
    const uint block_byte = (ib / nbpb) * row_bytes + meta + (ib % nbpb) * BLOCK_BYTES;

    const uint dw = block_byte / 4;
    const uint head = data_a32[dw];
    const float d = iqk_f16_to_f32(head & 0xffffu);
    const uint extra = head >> 16;
    const uint sc = data_a32[dw + 1 + ib64];
    const uint b_idx = QUANT_K * ib + 64 * ib64 + 32 * part + 4 * t;

    const uint shift = 4 * (ib64 % 2);
    const uint e = extra >> (4 * ib64);
    const uint qs_dw = (block_byte + 20 + 32 * ib64) / 4;
    const uint qh_dw = (block_byte + 148 + 32 * (ib64 / 2)) / 4;
    const uint j = t & 3;

    if (part == 0) {
        const float dl1 = d * float(int8_t(sc & 0xffu));
        const float dl2 = d * float(int8_t((sc >> 8) & 0xffu));
        const uint v1_off = (e & 1u) != 0 ? 64u : 0u;
        const uint v2_off = (e & 2u) != 0 ? 64u : 0u;
        if (t < 4) {
            iqk_store4(b_idx, dl1 * iq6k_lo(data_a32[qs_dw + j], data_a32[qh_dw + j], shift, v1_off));
        } else {
            iqk_store4(b_idx, dl2 * iq6k_lo(data_a32[qs_dw + 4 + j], data_a32[qh_dw + 4 + j], shift, v2_off));
        }
    } else {
        const float dl1 = d * float(int8_t((sc >> 16) & 0xffu));
        const float dl2 = d * float(int8_t((sc >> 24) & 0xffu));
        const uint v1_off = (e & 4u) != 0 ? 64u : 0u;
        const uint v2_off = (e & 8u) != 0 ? 64u : 0u;
        if (t < 4) {
            iqk_store4(b_idx, dl1 * iq6k_hi(data_a32[qs_dw + j], data_a32[qh_dw + j], shift, v1_off));
        } else {
            iqk_store4(b_idx, dl2 * iq6k_hi(data_a32[qs_dw + 4 + j], data_a32[qh_dw + 4 + j], shift, v2_off));
        }
    }
}
