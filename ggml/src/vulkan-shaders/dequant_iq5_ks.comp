#version 450

#include "dequant_head.comp"
#include "iqk_tables.comp"
#include "dequant_iqk_common.comp"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

#define QUANT_K 256
#define BLOCK_BYTES 168
#define META 4

// Value table staged in shared memory: entry i = iq5nl_values[i].
shared int8_t iq5ks_tbl[64];

void main() {
    const uint tid = gl_LocalInvocationID.x;
    [[unroll]] for (uint idx = tid; idx < 16; idx += 256) {
        const uint w = iq5nl_values_packed[idx];
        iq5ks_tbl[4 * idx + 0] = int8_t(w & 0xffu);
        iq5ks_tbl[4 * idx + 1] = int8_t((w >> 8) & 0xffu);
        iq5ks_tbl[4 * idx + 2] = int8_t((w >> 16) & 0xffu);
        iq5ks_tbl[4 * idx + 3] = int8_t(w >> 24);
    }
    barrier();

    // 64 threads per block: thread (ib64, part, j) decodes one vec4.
    const uint ib = gl_WorkGroupID.x * 4 + tid / 64;
    const uint ib64 = (tid % 64) / 16;
    const uint part = (tid % 16) / 8;
    const uint j = tid % 8;

    if (ib >= p.nel / QUANT_K) {
        return;
    }

    const uint nbpb = p.K;
    const uint meta = p.stride_a;
    const uint row_bytes = meta + nbpb * BLOCK_BYTES;
    const uint row = ib / nbpb;
    const uint block_byte = row * row_bytes + META + (ib % nbpb) * BLOCK_BYTES;

    const float d = uintBitsToFloat(data_a32[(row * row_bytes) / 4]);
    const uint sc01 = data_a32[block_byte / 4];
    const uint sc23 = data_a32[block_byte / 4 + 1];
    const uint b_idx = QUANT_K * ib + 64 * ib64 + 32 * part + 4 * j;

    const uint sc_dw = ib64 < 2 ? sc01 : sc23;
    const uint sc = (sc_dw >> (16 * (ib64 & 1) + 8 * part)) & 0xffu;
    const float dl = d * (float(sc & 254u) - 127.0f);
    const uint v_off = (sc & 1u) != 0 ? 32u : 0u;
    const uint sft_h = 2 * ib64 + part;
    const uint qs_dw = (block_byte + 8 + 32 * ib64) / 4;
    const uint qh_dw = (block_byte + 136) / 4;

    const uint qw = data_a32[qs_dw + j];
    const uint hw = data_a32[qh_dw + j];
    if (part == 0) {
        iqk_store4(b_idx, dl * vec4(
            float(iq5ks_tbl[((qw & 0xFu)       | ((((hw & 0xffu) >> sft_h) & 1u) << 4)) + v_off]),
            float(iq5ks_tbl[(((qw >> 8) & 0xFu)  | ((((hw >> 8 & 0xffu) >> sft_h) & 1u) << 4)) + v_off]),
            float(iq5ks_tbl[(((qw >> 16) & 0xFu) | ((((hw >> 16 & 0xffu) >> sft_h) & 1u) << 4)) + v_off]),
            float(iq5ks_tbl[(((qw >> 24) & 0xFu) | ((((hw >> 24 & 0xffu) >> sft_h) & 1u) << 4)) + v_off])));
    } else {
        iqk_store4(b_idx, dl * vec4(
            float(iq5ks_tbl[(((qw >> 4) & 0xFu)  | ((((hw & 0xffu) >> sft_h) & 1u) << 4)) + v_off]),
            float(iq5ks_tbl[(((qw >> 12) & 0xFu) | ((((hw >> 8 & 0xffu) >> sft_h) & 1u) << 4)) + v_off]),
            float(iq5ks_tbl[(((qw >> 20) & 0xFu) | ((((hw >> 16 & 0xffu) >> sft_h) & 1u) << 4)) + v_off]),
            float(iq5ks_tbl[(((qw >> 28) & 0xFu) | ((((hw >> 24 & 0xffu) >> sft_h) & 1u) << 4)) + v_off])));
    }
}
