#version 450

#include "dequant_head.comp"
#include "iqk_tables.comp"
#include "dequant_iqk_common.comp"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

#define QUANT_K 256
#define BLOCK_BYTES 168
#define META 4

// Value table staged in shared memory as int entries (int8 entries crowd 16
// shared-memory banks and conflict).
shared int iq5ks_tbl[64];

// low nibbles of the 4 qs bytes; high bit = qh bit sft_h
vec4 iq5ks_lo(uint qw, uint hw, uint sft_h, uint v_off) {
    return vec4(
        float(iq5ks_tbl[((qw & 0xFu)       | ((((hw & 0xffu) >> sft_h) & 1u) << 4)) + v_off]),
        float(iq5ks_tbl[(((qw >> 8) & 0xFu)  | ((((hw >> 8 & 0xffu) >> sft_h) & 1u) << 4)) + v_off]),
        float(iq5ks_tbl[(((qw >> 16) & 0xFu) | ((((hw >> 16 & 0xffu) >> sft_h) & 1u) << 4)) + v_off]),
        float(iq5ks_tbl[(((qw >> 24) & 0xFu) | ((((hw >> 24 & 0xffu) >> sft_h) & 1u) << 4)) + v_off]));
}

// high nibbles of the 4 qs bytes; high bit = qh bit sft_h + 1
vec4 iq5ks_hi(uint qw, uint hw, uint sft_h, uint v_off) {
    return vec4(
        float(iq5ks_tbl[(((qw >> 4) & 0xFu)  | ((((hw & 0xffu) >> sft_h) & 2u) << 3)) + v_off]),
        float(iq5ks_tbl[(((qw >> 12) & 0xFu) | ((((hw >> 8 & 0xffu) >> sft_h) & 2u) << 3)) + v_off]),
        float(iq5ks_tbl[(((qw >> 20) & 0xFu) | ((((hw >> 16 & 0xffu) >> sft_h) & 2u) << 3)) + v_off]),
        float(iq5ks_tbl[(((qw >> 28) & 0xFu) | ((((hw >> 24 & 0xffu) >> sft_h) & 2u) << 3)) + v_off]));
}

void main() {
    const uint tid = gl_LocalInvocationID.x;
    [[unroll]] for (uint idx = tid; idx < 64; idx += 256) {
        const uint w = iq5nl_values_packed[idx / 4u];
        int v = int((w >> (8u * (idx % 4u))) & 0xffu);
        if (v >= 128) v -= 256;
        iq5ks_tbl[idx] = v;
    }
    barrier();

    // 16 threads per block: thread (ib64, k) decodes the low- and high-nibble
    // vec4 pairs of sub-block ib64 (of 4), qs dwords 2k and 2k+1 (of 8) --
    // 16 elements per thread, contiguous stores.
    const uint ib = gl_WorkGroupID.x * 16 + tid / 16;
    const uint ib64 = (tid % 16) / 4;
    const uint k = tid % 4;

    if (ib >= p.nel / QUANT_K) {
        return;
    }

    const uint nbpb = p.K;
    const uint meta = p.stride_a;
    const uint row_bytes = meta + nbpb * BLOCK_BYTES;
    const uint row = ib / nbpb;
    const uint block_byte = row * row_bytes + META + (ib % nbpb) * BLOCK_BYTES;

    const float d = uintBitsToFloat(data_a32[(row * row_bytes) / 4]);
    const uint sc01 = data_a32[block_byte / 4];
    const uint sc23 = data_a32[block_byte / 4 + 1];

    // sub-block ib64 spans 64 elements: elements 0..31 (low nibbles) use
    // scale 2*ib64 and qh bit 2*ib64, elements 32..63 (high nibbles) use scale
    // 2*ib64 + 1 and qh bit 2*ib64 + 1
    const uint sc_dw = ib64 < 2 ? sc01 : sc23;
    const uint sc_lo = (sc_dw >> (16 * (ib64 & 1))) & 0xffu;
    const uint sc_hi = (sc_dw >> (16 * (ib64 & 1) + 8)) & 0xffu;
    const float dl_lo = d * (float(sc_lo & 254u) - 127.0f);
    const float dl_hi = d * (float(sc_hi & 254u) - 127.0f);
    const uint v_off_lo = (sc_lo & 1u) != 0 ? 32u : 0u;
    const uint v_off_hi = (sc_hi & 1u) != 0 ? 32u : 0u;
    const uint sft_h = 2 * ib64;
    const uint qs_dw = (block_byte + 8 + 32 * ib64) / 4;
    const uint qh_dw = (block_byte + 136) / 4;

    const uint qw0 = data_a32[qs_dw + 2 * k];
    const uint hw0 = data_a32[qh_dw + 2 * k];
    const uint qw1 = data_a32[qs_dw + 2 * k + 1];
    const uint hw1 = data_a32[qh_dw + 2 * k + 1];

    const uint b_idx = QUANT_K * ib + 64 * ib64 + 8 * k;
    iqk_store4(b_idx,        dl_lo * iq5ks_lo(qw0, hw0, sft_h, v_off_lo));
    iqk_store4(b_idx + 4,    dl_lo * iq5ks_lo(qw1, hw1, sft_h, v_off_lo));
    iqk_store4(b_idx + 32,   dl_hi * iq5ks_hi(qw0, hw0, sft_h, v_off_hi));
    iqk_store4(b_idx + 36,   dl_hi * iq5ks_hi(qw1, hw1, sft_h, v_off_hi));
}
