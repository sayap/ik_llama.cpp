#version 450

#include "dequant_head.comp"
#include "iqk_tables.comp"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout (binding = 1) writeonly buffer D {D_TYPE data_b[];};

#define QUANT_K 256
#define BLOCK_BYTES 168
#define META 4

void main() {
    const uint ib = gl_WorkGroupID.x * 32 + gl_LocalInvocationID.x / 8;
    const uint ib64 = gl_LocalInvocationID.x % 4;
    const uint part = (gl_LocalInvocationID.x % 8) / 4;

    if (ib >= p.nel / QUANT_K) {
        return;
    }

    const uint nbpb = p.K;
    const uint meta = p.stride_a;
    const uint row_bytes = meta + nbpb * BLOCK_BYTES;
    const uint block_byte = (ib / nbpb) * row_bytes + META + (ib % nbpb) * BLOCK_BYTES;

    const float d = uintBitsToFloat(iqk_load_u32(block_byte - META));
    const uint sc = data_a[block_byte + 2 * ib64 + part];
    const float dl = d * (float(sc & 254u) - 127.0f);
    const uint v_off = (sc & 1u) != 0 ? 32 : 0;
    const uint sft_h = 2 * ib64 + part;

    const uint b_idx = QUANT_K * ib + 64 * ib64 + 32 * part;
    const uint qs_off = 8 + 32 * ib64;
    const uint qh_off = 136;
    [[unroll]] for (uint j = 0; j < 32; ++j) {
        const uint q = data_a[block_byte + qs_off + j];
        const uint hb = data_a[block_byte + qh_off + j];
        const uint idx = (part == 0)
            ? ((q & 0xFu) | (((hb >> sft_h) & 1u) << 4))
            : ((q >> 4) | (((hb >> sft_h) & 1u) << 4));
        data_b[b_idx + j] = D_TYPE(dl * float(iq5nl_values[idx + v_off]));
    }
}
