#version 450

#include "dequant_head.comp"
#include "iqk_tables.comp"
#include "dequant_iqk_common.comp"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

#define QUANT_K 256
#define BLOCK_BYTES 168
#define META 4

vec4 iq5ks_lo(uint qw, uint hw, uint sft_h, uint vo) {
    return vec4(
        float(iq5nl_values[((qw & 0xFu) | ((((hw & 0xffu) >> sft_h) & 1u) << 4)) + vo]),
        float(iq5nl_values[((((qw >> 8) & 0xFu) | ((((hw >> 8) & 0xffu) >> sft_h & 1u) << 4))) + vo]),
        float(iq5nl_values[((((qw >> 16) & 0xFu) | ((((hw >> 16) & 0xffu) >> sft_h & 1u) << 4))) + vo]),
        float(iq5nl_values[((((qw >> 24) & 0xFu) | ((((hw >> 24) & 0xffu) >> sft_h & 1u) << 4))) + vo]));
}

vec4 iq5ks_hi(uint qw, uint hw, uint sft_h, uint vo) {
    return vec4(
        float(iq5nl_values[((((qw >> 4) & 0xFu) | ((((hw & 0xffu) >> sft_h) & 1u) << 4))) + vo]),
        float(iq5nl_values[((((qw >> 12) & 0xFu) | ((((hw >> 8) & 0xffu) >> sft_h & 1u) << 4))) + vo]),
        float(iq5nl_values[((((qw >> 20) & 0xFu) | ((((hw >> 16) & 0xffu) >> sft_h & 1u) << 4))) + vo]),
        float(iq5nl_values[((((qw >> 28) & 0xFu) | ((((hw >> 24) & 0xffu) >> sft_h & 1u) << 4))) + vo]));
}

void main() {
    const uint ib = gl_WorkGroupID.x * 32 + gl_LocalInvocationID.x / 8;
    const uint ib64 = gl_LocalInvocationID.x % 4;
    const uint part = (gl_LocalInvocationID.x % 8) / 4;

    if (ib >= p.nel / QUANT_K) {
        return;
    }

    const uint nbpb = p.K;
    const uint meta = p.stride_a;
    const uint row_bytes = meta + nbpb * BLOCK_BYTES;
    const uint row = ib / nbpb;
    const uint block_byte = row * row_bytes + META + (ib % nbpb) * BLOCK_BYTES;

    const float d = uintBitsToFloat(data_a32[(row * row_bytes) / 4]);
    const uint sc01 = data_a32[block_byte / 4];
    const uint sc23 = data_a32[block_byte / 4 + 1];
    const uint b_idx = QUANT_K * ib + 64 * ib64 + 32 * part;

    const uint sc_dw = ib64 < 2 ? sc01 : sc23;
    const uint sc = (sc_dw >> (16 * (ib64 & 1) + 8 * part)) & 0xffu;
    const float dl = d * (float(sc & 254u) - 127.0f);
    const uint v_off = (sc & 1u) != 0 ? 32u : 0u;
    const uint sft_h = 2 * ib64 + part;
    const uint qs_dw = (block_byte + 8 + 32 * ib64) / 4;
    const uint qh_dw = (block_byte + 136) / 4;

    if (part == 0) {
        [[unroll]] for (uint j = 0; j < 8; ++j) {
            iqk_store4(b_idx + 4 * j, dl * iq5ks_lo(data_a32[qs_dw + j], data_a32[qh_dw + j], sft_h, v_off));
        }
    } else {
        [[unroll]] for (uint j = 0; j < 8; ++j) {
            iqk_store4(b_idx + 4 * j, dl * iq5ks_hi(data_a32[qs_dw + j], data_a32[qh_dw + j], sft_h, v_off));
        }
    }
}
