#version 450

#include "generic_head.comp"
#include "types.comp"

#extension GL_EXT_control_flow_attributes : enable

layout(local_size_x = 512, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) readonly buffer X {A_TYPE data_a[];};
layout (binding = 1) readonly buffer Y {B_TYPE data_b[];};
layout (binding = 2) writeonly buffer D {D_TYPE data_d[];};

// SwiGLU with the OAI ("swiglu_oai") activation, as used by step35/deepseek4 models:
//   gate: min(x, 7) / (1 + exp(-min(x, 7) * 1.702))
//   up:   1 + clamp(y, -7, 7)
//   out = gate * up

void main() {
    const float ALPHA = 1.702f;
    const float LIMIT = 7.0f;
    const uint i = gl_GlobalInvocationID.z * 262144 + gl_GlobalInvocationID.y * 512 + gl_GlobalInvocationID.x;

    if (i >= p.KX) {
        return;
    }

    const float xi = min(float(data_a[i]), LIMIT);
    const float gi = clamp(float(data_b[i]), -LIMIT, LIMIT);
    data_d[i] = D_TYPE((xi / (1.0f + exp(-xi * ALPHA))) * (1.0f + gi));
}
