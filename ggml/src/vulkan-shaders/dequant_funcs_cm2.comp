    const uint qh_off = 68;
    uint sign_mask = 0;
    [[unroll]] for (uint t = 0; t < 4; ++t) {
        sign_mask |= ((data_a[block_byte + qh_off + 8 * j + (k < 4 ? 0 : 4) + t] >> ib32) & 1u) << t;
    }
    uint x = iqk_load_u16(block_byte + 4 + 8 * ib32 + 2 * j) + 4096u;
    return float16_t(dl * iqk_cm2_hash_round(x, k + 1, true, sign_mask));
