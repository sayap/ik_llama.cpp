    const uint part = (e0 % 64) / 32;
    const uint j0 = e0 % 32;
    const uint nbpb = p.K / 256;
    const uint row_bytes = nbpb * 176;
    const uint block_byte = (iqk_cm2_batch_idx() * p.M + blockCoords[0]) * row_bytes + blockCoords[1] * 176;

    const uint shift = 2 * ib64;
    const uint extra = iqk_load_u16(block_byte + 2);
    const uint e_shift = extra >> (4 * ib64);
    const uint v1_off = (e_shift & (1u << (2 * part))) != 0 ? 32 : 0;
    const uint v2_off = (e_shift & (2u << (2 * part))) != 0 ? 32 : 0;
    const float d = iqk_f16_to_f32(iqk_load_u16(block_byte));
    const uint sh = data_a[block_byte + 4 + ib64];
    const uint sl = data_a[block_byte + 8 + 2 * ib64 + part];
    const uint s = (part == 0)
        ? (j0 < 16 ? ((sl & 0xFu) | ((sh << 4) & 0x30u)) : ((sl >> 4) | ((sh << 2) & 0x30u)))
        : (j0 < 16 ? ((sl & 0xFu) | (sh & 0x30u))      : ((sl >> 4) | ((sh >> 2) & 0x30u)));
    const float dl = d * (float(s) - 32.0f);
    const uint v_off = j0 < 16 ? v1_off : v2_off;

    const uint qs32 = iqk_load_u32(block_byte + 16 + 32 * ib64 + j0);
    const uint hs32 = iqk_load_u32(block_byte + 144 + j0);
    u8vec4 qv, hv;
    if (part == 0) {
        qv = unpack8(qs32 & 0x0F0F0F0Fu);
        hv = unpack8((hs32 >> shift) & 0x01010101u);
        return f16vec4(dl * float(iq5nl_values[(qv.x | (hv.x << 4)) + v_off]), dl * float(iq5nl_values[(qv.y | (hv.y << 4)) + v_off]),
                       dl * float(iq5nl_values[(qv.z | (hv.z << 4)) + v_off]), dl * float(iq5nl_values[(qv.w | (hv.w << 4)) + v_off]));
    } else {
