    const uint v_off = ((extra >> (8 + k)) & 1u) != 0 ? 8 : 0;

    const u8vec4 qv = unpack8((iqk_load_u32(block_byte + 6 + 32 * (k / 4) + j0) >> (2 * (k % 4))) & 0x03030303u);
    const u8vec4 hv = unpack8((iqk_load_u32(block_byte + 70 + j0) >> k) & 0x01010101u);
    return f16vec4(dl * float(iq3nl_values[(qv.x | (hv.x << 2)) + v_off]), dl * float(iq3nl_values[(qv.y | (hv.y << 2)) + v_off]),
                   dl * float(iq3nl_values[(qv.z | (hv.z << 2)) + v_off]), dl * float(iq3nl_values[(qv.w | (hv.w << 2)) + v_off]));
}
#endif

#if defined(DATA_A_IQ4_KS)
f16vec4 dequantFuncIQ4_KS_v(const in decodeBufQ4_0 bl, const in uint blockCoords[2], const in uint coordInBlock[2])
{
    const uint e0 = coordInBlock[1];
    const uint ib32 = e0 / 32;
    const uint j0 = e0 % 32;
    const uint nbpb = p.K / 256;
    const uint row_bytes = 4 + nbpb * 136;
    const uint row_byte = (iqk_cm2_batch_idx() * p.M + blockCoords[0]) * row_bytes;
    const uint block_byte = row_byte + 4 + blockCoords[1] * 136;

    const float d = uintBitsToFloat(iqk_load_u32(row_byte));
    const uint sc = data_a[block_byte + ib32];
    const float dl = d * (float(sc & 254u) - 127.0f);
    const uint v_off = (sc & 1u) != 0 ? 16 : 0;
    const bool lo = j0 < 16;

    const uint qs32 = iqk_load_u32(block_byte + 8 + 16 * ib32 + (j0 & 15));
    const u8vec4 qv = unpack8(lo ? (qs32 & 0x0F0F0F0Fu) : ((qs32 >> 4) & 0x0F0F0F0Fu));
    return f16vec4(dl * float(iq4k_values[qv.x + v_off]), dl * float(iq4k_values[qv.y + v_off]),
                   dl * float(iq4k_values[qv.z + v_off]), dl * float(iq4k_values[qv.w + v_off]));
}
#endif

#if defined(DATA_A_IQ4_KSS)
f16vec4 dequantFuncIQ4_KSS_v(const in decodeBufQ4_0 bl, const in uint blockCoords[2], const in uint coordInBlock[2])
{
    const uint e0 = coordInBlock[1];
    const uint ib32 = e0 / 32;
    const uint jj0 = e0 % 16;
    const uint nbpb = p.K / 256;
    const uint row_bytes = 4 + nbpb * 128;
    const uint row_byte = (iqk_cm2_batch_idx() * p.M + blockCoords[0]) * row_bytes;
    const uint block_byte = row_byte + 4 + blockCoords[1] * 128;

    const float d = uintBitsToFloat(iqk_load_u32(row_byte));
    const uint qs16_off = 16 * ib32;
    uint ls = 0;
    uint a8[4] = { 0, 0, 0, 0 };
    [[unroll]] for (uint k = 0; k < 8; ++k) {
        const uint q16 = iqk_load_u16(block_byte + qs16_off + 2 * k);
        uint a = q16 & 0xfffeu;
        a ^= a >> 1;
        [[unroll]] for (uint i = 0; i < 4; ++i) {
            if (k == (jj0 + i) / 2) {
                a8[i] = (a >> (8 * ((jj0 + i) & 1))) & 0xffu;
            }
        }
        ls |= (q16 & 1u) << k;
    }
    const float dl = d * (float(ls & 254u) - 127.0f);
    const uint v_off = (ls & 1u) != 0 ? 16 : 0;
    const bool lo = (e0 % 32) < 16;

    return f16vec4(dl * float(iq4k_values[(lo ? (a8[0] & 0xFu) : (a8[0] >> 4)) + v_off]),
                   dl * float(iq4k_values[(lo ? (a8[1] & 0xFu) : (a8[1] >> 4)) + v_off]),
                   dl * float(iq4k_values[(lo ? (a8[2] & 0xFu) : (a8[2] >> 4)) + v_off]),
                   dl * float(iq4k_values[(lo ? (a8[3] & 0xFu) : (a8[3] >> 4)) + v_off]));
}
#endif

#if defined(DATA_A_IQ5_KS)
f16vec4 dequantFuncIQ5_KS_v(const in decodeBufQ4_0 bl, const in uint blockCoords[2], const in uint coordInBlock[2])
{
    const uint e0 = coordInBlock[1];
    const uint ib64 = e0 / 64;
    const uint part = (e0 % 64) / 32;
    const uint j0 = e0 % 32;
    const uint nbpb = p.K / 256;
    const uint row_bytes = 4 + nbpb * 168;
    const uint row_byte = (iqk_cm2_batch_idx() * p.M + blockCoords[0]) * row_bytes;
    const uint block_byte = row_byte + 4 + blockCoords[1] * 168;

    const float d = uintBitsToFloat(iqk_load_u32(row_byte));
    const uint sc = data_a[block_byte + 2 * ib64 + part];
    const float dl = d * (float(sc & 254u) - 127.0f);
    const uint v_off = (sc & 1u) != 0 ? 32 : 0;
    const uint sft_h = 2 * ib64 + part;

    const uint qs32 = iqk_load_u32(block_byte + 8 + 32 * ib64 + j0);
    const uint hs32 = iqk_load_u32(block_byte + 136 + j0);
    const u8vec4 qv = unpack8((part == 0 ? qs32 : (qs32 >> 4)) & 0x0F0F0F0Fu);
    const u8vec4 hv = unpack8((hs32 >> sft_h) & 0x01010101u);
    return f16vec4(dl * float(iq5nl_values[(qv.x | (hv.x << 4)) + v_off]), dl * float(iq5nl_values[(qv.y | (hv.y << 4)) + v_off]),
                   dl * float(iq5nl_values[(qv.z | (hv.z << 4)) + v_off]), dl * float(iq5nl_values[(qv.w | (hv.w << 4)) + v_off]));
}
#endif

#if defined(DATA_A_IQ2_KL)
f16vec4 dequantFuncIQ2_KL_v(const in decodeBufQ4_0 bl, const in uint blockCoords[2], const in uint coordInBlock[2])
{
    const uint e0 = coordInBlock[1];
    const uint ib64 = e0 / 64;
    const uint part = (e0 % 64) / 32;
    const uint j0 = e0 % 32;
    const uint nbpb = p.K / 256;
    const uint row_bytes = 2 + nbpb * 86;
    const uint row_byte = (iqk_cm2_batch_idx() * p.M + blockCoords[0]) * row_bytes;
    const uint block_byte = row_byte + 2 + blockCoords[1] * 86;

    const float d = iqk_f16_to_f32(iqk_load_u16(row_byte));
    const uint scales_h = iqk_load_u16(block_byte);
    const uint sc = data_a[block_byte + 2 + (2 * ib64 + part) % 4];
    const float dl = d * (float(((sc >> (4 * (ib64 / 2))) & 0xFu) | (((scales_h >> (4 * ib64 + 2 * part)) & 3u) << 4)) - 32.0f);
    const uint sft_h = 2 * ib64 + part;

    // 4 elements share 2 q bytes (one 16-bit word) and 2 h bytes; each byte
    // yields one qv -> one 16-bit value pair.
    const uint q16 = iqk_load_u16(block_byte + 6 + 16 * ib64 + j0 / 2);
    const uint h16 = iqk_load_u16(block_byte + 70 + j0 / 2);
    const uint qv0 = (part == 0) ? ((q16 & 0xFu) | (((h16 >> sft_h) & 1u) << 4))
                                 : (((q16 >> 4) & 0xFu) | (((h16 >> (sft_h + 4)) & 1u) << 4));
    const uint qv1 = (part == 0) ? (((q16 >> 8) & 0xFu) | (((h16 >> (sft_h + 8)) & 1u) << 4))
                                 : ((q16 >> 12) | (((h16 >> (sft_h + 12)) & 1u) << 4));
    const uint v0 = iq2kl_values[qv0];
    const uint v1 = iq2kl_values[qv1];
    return f16vec4(dl * float(int8_t(v0 & 0xffu)), dl * float(int8_t(v0 >> 8)),
                   dl * float(int8_t(v1 & 0xffu)), dl * float(int8_t(v1 >> 8)));
}
#endif

#if defined(DATA_A_IQ1_KT)
f16vec4 dequantFuncIQ1_KT_v(const in decodeBufQ4_0 bl, const in uint blockCoords[2], const in uint coordInBlock[2])
{
    const uint e0 = coordInBlock[1];
    const uint ib32 = e0 / 32;
    const uint j0 = (e0 % 32) / 8;
    const uint k0 = e0 % 8;
    const uint nbpb = p.K / 256;
    const uint row_bytes = 4 + nbpb * 56;
    const uint row_byte = (iqk_cm2_batch_idx() * p.M + blockCoords[0]) * row_bytes;
    const uint block_byte = row_byte + 4 + blockCoords[1] * 56;

    const float d = uintBitsToFloat(iqk_load_u32(row_byte));
    const uint sh_byte = data_a[block_byte + ib32];
    const float dl = d * float(iq4k_values[sh_byte & 0xFu]);

    const uint ql_off = 8 + 4 * ib32;
    const uint qh_off = 40 + 4 * (ib32 % 4);
    const uint sh_shift = 8 - 4 * (ib32 / 4);
    uint x = uint(data_a[block_byte + ql_off + j0])
           + 4096u
           + ((uint(data_a[block_byte + qh_off + j0]) << sh_shift) & 0xf00u)
           + ((sh_byte << (8 - j0)) & 0x1000u);
    f16vec4 res;
    [[unroll]] for (uint k = 0; k < 4; ++k) {
        res[k] = float16_t(dl * iqk_cm2_hash_round(x, k0 + k + 1, false, 0u));
    }
    return res;
}
#endif

#if defined(DATA_A_IQ2_KT)
f16vec4 dequantFuncIQ2_KT_v(const in decodeBufQ4_0 bl, const in uint blockCoords[2], const in uint coordInBlock[2])
{
    const uint e0 = coordInBlock[1];
    const uint ib32 = e0 / 32;
    const uint j0 = (e0 % 32) / 8;
    const uint k0 = e0 % 8;
    const uint nbpb = p.K / 256;
    const uint row_bytes = 4 + nbpb * 68;
    const uint row_byte = (iqk_cm2_batch_idx() * p.M + blockCoords[0]) * row_bytes;
    const uint block_byte = row_byte + 4 + blockCoords[1] * 68;

    const float d = uintBitsToFloat(iqk_load_u32(row_byte));
    const uint sc = data_a[block_byte + ib32 % 4] >> (4 * (ib32 / 4));
    const float dl = d * 1.05f * float(iq4k_values[sc & 0xFu]);

    uint x = iqk_load_u16(block_byte + 4 + 8 * ib32 + 2 * j0) + 4096u;
    f16vec4 res;
    [[unroll]] for (uint k = 0; k < 4; ++k) {
        res[k] = float16_t(dl * iqk_cm2_hash_round(x, k0 + k + 1, false, 0u));
    }
    return res;
}
#endif

#if defined(DATA_A_IQ3_KT)
f16vec4 dequantFuncIQ3_KT_v(const in decodeBufQ4_0 bl, const in uint blockCoords[2], const in uint coordInBlock[2])
{
    const uint e0 = coordInBlock[1];
    const uint ib32 = e0 / 32;
    const uint j0 = (e0 % 32) / 8;
    const uint k0 = e0 % 8;
    const uint nbpb = p.K / 256;
    const uint row_bytes = 4 + nbpb * 100;
    const uint row_byte = (iqk_cm2_batch_idx() * p.M + blockCoords[0]) * row_bytes;
    const uint block_byte = row_byte + 4 + blockCoords[1] * 100;

    const float d = uintBitsToFloat(iqk_load_u32(row_byte));
    const uint sc = data_a[block_byte + ib32 % 4] >> (4 * (ib32 / 4));
    const float dl = d * 1.01f * float(sc & 0xFu);

    const uint qh_off = 68;
    uint sign_mask = 0;
    [[unroll]] for (uint t = 0; t < 4; ++t) {
        sign_mask |= ((data_a[block_byte + qh_off + 8 * j0 + k0 + t] >> ib32) & 1u) << t;
    }
    uint x = iqk_load_u16(block_byte + 4 + 8 * ib32 + 2 * j0) + 4096u;
    f16vec4 res;
    [[unroll]] for (uint k = 0; k < 4; ++k) {
        res[k] = float16_t(dl * iqk_cm2_hash_round(x, k0 + k + 1, true, sign_mask));
    }
    return res;
}
#endif

#if defined(DATA_A_IQ4_KT)
f16vec4 dequantFuncIQ4_KT_v(const in decodeBufQ4_0 bl, const in uint blockCoords[2], const in uint coordInBlock[2])
{
    const uint e0 = coordInBlock[1];
    const uint ib32 = e0 / 32;
    const uint j0 = (e0 % 32) / 4;
    const uint nbpb = p.K / 256;
    const uint row_bytes = 4 + nbpb * 128;
    const uint row_byte = (iqk_cm2_batch_idx() * p.M + blockCoords[0]) * row_bytes;
    const uint block_byte = row_byte + 4 + blockCoords[1] * 128;

    const float d = uintBitsToFloat(iqk_load_u32(row_byte));
    const uint qs32 = iqk_load_u32(block_byte + 4 * ib32);
    const float dl = d * (float((qs32 & 0xffu) >> 1) - 64.0f);
    const uint idx0 = ((qs32 & 1u) << 15) + 4096u;

    const uint ql_off = 32 + 8 * ib32;
    const uint qh_off = 96 + 8 * (ib32 % 4);
    const uint sh_shift = 8 - 4 * (ib32 / 4);
    const uint sh = qs32 >> (8 + 3 * j0);
    uint x = uint(data_a[block_byte + ql_off + j0])
           + ((uint(data_a[block_byte + qh_off + j0]) << sh_shift) & 0xf00u)
           + ((sh & 7u) << 12)
           + idx0;
    f16vec4 res;
    [[unroll]] for (uint k = 0; k < 4; ++k) {
        res[k] = float16_t(dl * iqk_cm2_hash_round(x, k + 1, false, 0u));
    }
    return res;
}
#endif

