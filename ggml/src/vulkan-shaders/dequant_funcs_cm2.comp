// ---------------------------------------------------------------------------
// IQK (QK_K=256) and KT quant families: coopmat2 inline dequant.
//
// The cm2 tensor-core matmul (mul_mm_cm2.comp) loads the A matrix with a
// decode function per element. These formats are byte-addressed (256-element
// blocks of varying byte sizes, optionally with a per-row scale header), so
// the decode functions compute the element's absolute byte address from the
// push constants and the (absolute) block coordinates passed by the driver,
// and read the quantized bytes through the global binding-0 buffer (which is
// uint8_t for these types). `bl` is unused: the per-row META header means the
// driver-computed block pointer cannot point at the true block start.
//
// Layout: row r starts at batch_off + r*row_bytes where
//   row_bytes = META + nbpb*BLOCK_BYTES,  nbpb = p.K / 256
// and the 256-element block b sits at row start + META + b*BLOCK_BYTES.
// The base K family (IQ2_K..IQ6_K) has META=0 and each block carries its own
// 2-byte f16 d; the KS/KL/KT families carry one per-row scale header (2-byte
// f16 or 4-byte f32) at the row start.
// ---------------------------------------------------------------------------
#if defined(DATA_A_IQ2_K)   || defined(DATA_A_IQ3_K)   || defined(DATA_A_IQ4_K)   || \
    defined(DATA_A_IQ5_K)   || defined(DATA_A_IQ6_K)   || defined(DATA_A_IQ2_KS)  || \
    defined(DATA_A_IQ3_KS)  || defined(DATA_A_IQ4_KS)  || defined(DATA_A_IQ4_KSS) || \
    defined(DATA_A_IQ5_KS)  || defined(DATA_A_IQ2_KL)  || defined(DATA_A_IQ1_KT)  || \
    defined(DATA_A_IQ2_KT)  || defined(DATA_A_IQ3_KT)  || defined(DATA_A_IQ4_KT)

#define IQK_CM2 1
#define IQK_TABLES_NO_BINDING 1
#include "iqk_tables.comp"
#undef IQK_TABLES_NO_BINDING

// Batch/expert index of A (src0) for this workgroup. Mirrors main()'s
// batch_idx_a computation; the byte offsets are derived from p.M and p.K
// because the per-row META headers are not accounted for by the element
// strides.
uint iqk_cm2_batch_idx() {
#ifdef MUL_MAT_ID
    return gl_GlobalInvocationID.z;
#else
    const uint batch_idx = gl_GlobalInvocationID.z;
    const uint i13 = batch_idx / p.ne12;
    const uint i12 = batch_idx % p.ne12;
    const uint i03 = i13 / p.broadcast3;
    const uint i02 = i12 / p.broadcast2;
    return i03 * p.ne02 + i02;
#endif
}

// KT-family multiplicative-hash powers C^r (C = 0xCBAC1FED), so the value of
// hash round r can be computed with a single multiply instead of r chained
// multiplies (the vec/dequant kernels amortize the chain over 8 values; the
// cm2 decode is one element per call).
const uint iqk_cm2_hash_pow[8] = {
    0xCBAC1FEDu, 0xC8734169u, 0xBD2B4535u, 0xE50C7D11u,
    0x1220D7BDu, 0x94839CF9u, 0x58267985u, 0x60B19B21u,
};

// Value of hash round `round` (1..8) of the KT decode, starting from x0.
// Mirrors iqk_hash_values (x *= C, byte sum of x&0x3F3F3F3F minus 126, then
// optional abs and sign flip).
float iqk_cm2_hash_round(const uint x0, const uint round, const bool is_abs, const uint sign_mask) {
    const uint x = x0 * iqk_cm2_hash_pow[round - 1];
    const uint s = x & 0x3F3F3F3Fu;
#ifdef IQK_USE_DOT4
    float v = float(dotPacked4x8EXT(int(s), 0x01010101) - 126);
#else
    float v = float(int((s & 0xffu) + ((s >> 8) & 0xffu) + ((s >> 16) & 0xffu) + ((s >> 24) & 0xffu)) - 126);
#endif
    if (is_abs) v = abs(v);
    // sign bit index is the within-call value index (the KT decode calls the
    // 4-value hash twice per chain; rounds 5..8 reuse bits 0..3 of mask 2)
    if (((sign_mask >> ((round - 1) & 3u)) & 1u) != 0u) v = -v;
    return v;
}

#if defined(DATA_A_IQ2_K)
#define IQK_BLOCK_BYTES 76
#define IQK_META 0

float16_t dequantFuncIQ2_K(const in decodeBufQ4_0 bl, const in uint blockCoords[2], const in uint coordInBlock[2])
{
    const uint ib32 = coordInBlock[1] / 32;
    const uint j = coordInBlock[1] % 32;
    const uint nbpb = p.K / 256;
    const uint row_bytes = nbpb * 76;
    const uint block_byte = (iqk_cm2_batch_idx() * p.M + blockCoords[0]) * row_bytes + blockCoords[1] * 76;

    const uint extra = iqk_load_u16(block_byte + 2);
    const uint e_shift = extra >> (2 * ib32);
    const uint v1_off = (e_shift & 1u) != 0 ? 4 : 0;
    const uint v2_off = (e_shift & 2u) != 0 ? 4 : 0;

    const float d = iqk_f16_to_f32(iqk_load_u16(block_byte));
    const uint sc = data_a[block_byte + 4 + ib32];
    const float dl = d * (float(j < 16 ? (sc & 0xFu) : (sc >> 4)) - 8.0f);
    const uint v_off = j < 16 ? v1_off : v2_off;

    const uint qs_off = 12 + (ib32 / 4) * 32;
    const uint q = (data_a[block_byte + qs_off + j] >> (2 * (ib32 % 4))) & 3u;
    return float16_t(dl * float(iq2nl_values[q + v_off]));
}
#endif

#if defined(DATA_A_IQ3_K)
#define IQK_BLOCK_BYTES 110
#define IQK_META 0

float16_t dequantFuncIQ3_K(const in decodeBufQ4_0 bl, const in uint blockCoords[2], const in uint coordInBlock[2])
{
    const uint ib32 = coordInBlock[1] / 32;
    const uint j = coordInBlock[1] % 32;
    const uint nbpb = p.K / 256;
    const uint row_bytes = nbpb * 110;
    const uint block_byte = (iqk_cm2_batch_idx() * p.M + blockCoords[0]) * row_bytes + blockCoords[1] * 110;

    const uint extra = iqk_load_u16(block_byte + 2);
    const uint sh = iqk_load_u16(block_byte + 4);
    const uint e_shift = extra >> (2 * ib32);
    const uint v1_off = (e_shift & 1u) != 0 ? 8 : 0;
    const uint v2_off = (e_shift & 2u) != 0 ? 8 : 0;

    const float d = iqk_f16_to_f32(iqk_load_u16(block_byte));
    const uint sc = data_a[block_byte + 6 + ib32];
    const float dl = d * (2.0f * float(j < 16 ? (sc & 0xFu) : (sc >> 4)) + 1.0f)
                    * (((sh >> (2 * ib32 + (j < 16 ? 0 : 1))) & 1u) != 0 ? -1.0f : 1.0f);
    const uint v_off = j < 16 ? v1_off : v2_off;

    const uint q = (data_a[block_byte + 14 + (ib32 / 4) * 32 + j] >> (2 * (ib32 % 4))) & 3u;
    const uint h = (data_a[block_byte + 78 + j] >> (ib32 % 8)) & 1u;
    return float16_t(dl * float(iq3nl_values[(q | (h << 2)) + v_off]));
}
#endif

#if defined(DATA_A_IQ4_K)
#define IQK_BLOCK_BYTES 144
#define IQK_META 0

float16_t dequantFuncIQ4_K(const in decodeBufQ4_0 bl, const in uint blockCoords[2], const in uint coordInBlock[2])
{
    const uint ib32 = coordInBlock[1] / 32;
    const uint j = coordInBlock[1] % 32;
    const uint nbpb = p.K / 256;
    const uint row_bytes = nbpb * 144;
    const uint block_byte = (iqk_cm2_batch_idx() * p.M + blockCoords[0]) * row_bytes + blockCoords[1] * 144;

    const uint extra = iqk_load_u16(block_byte + 2);
    const uint e_shift = extra >> (2 * ib32);
    const uint v1_off = (e_shift & 1u) != 0 ? 16 : 0;
    const uint v2_off = (e_shift & 2u) != 0 ? 16 : 0;

    const float d = iqk_f16_to_f32(iqk_load_u16(block_byte));
    const uint sh = data_a[block_byte + 4 + ib32 / 2] >> (4 * (ib32 % 2));
    const uint sc = data_a[block_byte + 8 + ib32];
    const uint s = j < 16 ? (sc & 0xFu) | ((sh << 4) & 0x30u) : (sc >> 4) | ((sh << 2) & 0x30u);
    const float dl = d * (float(s) - 32.0f);
    const uint v_off = j < 16 ? v1_off : v2_off;

    const uint q = data_a[block_byte + 16 + 16 * ib32 + (j & 15)];
    return float16_t(dl * float(iq4k_values[(j < 16 ? (q & 0xFu) : (q >> 4)) + v_off]));
