#if defined(DATA_A_IQ3_KT)
#define IQK_BLOCK_BYTES 100
#define IQK_META 4

float16_t dequantFuncIQ3_KT(const in decodeBufQ4_0 bl, const in uint blockCoords[2], const in uint coordInBlock[2])
{
