    const float d = uintBitsToFloat(iqk_load_u32(row_byte));
    const uint sc = data_a[block_byte + 2 * ib64 + part];
    const float dl = d * (float(sc & 254u) - 127.0f);
    const uint v_off = (sc & 1u) != 0 ? 32 : 0;
    const uint sft_h = 2 * ib64 + part;

    const uint q = data_a[block_byte + 8 + 32 * ib64 + j];
    const uint hb = data_a[block_byte + 136 + j];
    const uint qv = (part == 0)
        ? ((q & 0xFu) | (((hb >> sft_h) & 1u) << 4))
        : ((q >> 4) | (((hb >> sft_h) & 1u) << 4));
    return float16_t(dl * float(iq5nl_values[qv + v_off]));
