#if defined(DATA_A_IQ2_KS)
#define IQK_BLOCK_BYTES 70
#define IQK_META 2

float16_t dequantFuncIQ2_KS(const in decodeBufQ4_0 bl, const in uint blockCoords[2], const in uint coordInBlock[2])
{
    const uint ib64 = coordInBlock[1] / 64;
    const uint part = (coordInBlock[1] % 64) / 32;
