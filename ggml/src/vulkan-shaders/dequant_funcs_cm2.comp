    const float d = uintBitsToFloat(iqk_load_u32(row_byte));
    const uint qs32 = iqk_load_u32(block_byte + 4 * ib32);
    const float dl = d * (float((qs32 & 0xffu) >> 1) - 64.0f);
    const uint idx0 = ((qs32 & 1u) << 15) + 4096u;

    const uint ql_off = 32 + 8 * ib32;
    const uint qh_off = 96 + 8 * (ib32 % 4);
