#if defined(DATA_A_IQ3_KS)
#define IQK_BLOCK_BYTES 102
#define IQK_META 2

float16_t dequantFuncIQ3_KS(const in decodeBufQ4_0 bl, const in uint blockCoords[2], const in uint coordInBlock[2])
{
    const uint k = coordInBlock[1] / 32;
    const uint j = coordInBlock[1] % 32;
    const uint nbpb = p.K / 256;
    const uint row_bytes = 2 + nbpb * 102;
    const uint row_byte = (iqk_cm2_batch_idx() * p.M + blockCoords[0]) * row_bytes;
    const uint block_byte = row_byte + 2 + blockCoords[1] * 102;

    const uint extra = iqk_load_u16(block_byte);
    const float d = iqk_f16_to_f32(iqk_load_u16(row_byte));
    const uint sc = data_a[block_byte + 2 + k % 4];
    const float dl = d * (float(((sc >> (4 * (k / 4))) & 0xFu) | (((extra >> k) & 1u) << 4)) - 16.0f);
    const uint v_off = ((extra >> (8 + k)) & 1u) != 0 ? 8 : 0;

    const uint q = (data_a[block_byte + 6 + 32 * (k / 4) + j] >> (2 * (k % 4))) & 3u;
    const uint hb = (data_a[block_byte + 70 + j] >> k) & 1u;
    return float16_t(dl * float(iq3nl_values[(q | (hb << 2)) + v_off]));
}
#endif

#if defined(DATA_A_IQ4_KS)
#define IQK_BLOCK_BYTES 136
#define IQK_META 4

float16_t dequantFuncIQ4_KS(const in decodeBufQ4_0 bl, const in uint blockCoords[2], const in uint coordInBlock[2])
{
    const uint ib32 = coordInBlock[1] / 32;
    const uint j = coordInBlock[1] % 32;
    const uint nbpb = p.K / 256;
    const uint row_bytes = 4 + nbpb * 136;
