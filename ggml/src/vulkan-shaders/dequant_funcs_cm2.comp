#if defined(DATA_A_IQ4_KSS)
#define IQK_BLOCK_BYTES 128
#define IQK_META 4

float16_t dequantFuncIQ4_KSS(const in decodeBufQ4_0 bl, const in uint blockCoords[2], const in uint coordInBlock[2])
{
    const uint ib32 = coordInBlock[1] / 32;
    const uint jj = coordInBlock[1] % 16;        // 0..15, pairs of elements share one aux16 value
    const bool lo = (coordInBlock[1] % 32) < 16; // low or high nibble of a8
    const uint nbpb = p.K / 256;
    const uint row_bytes = 4 + nbpb * 128;
    const uint row_byte = (iqk_cm2_batch_idx() * p.M + blockCoords[0]) * row_bytes;
    const uint block_byte = row_byte + 4 + blockCoords[1] * 128;

    const float d = uintBitsToFloat(iqk_load_u32(row_byte));
    // The sub-block's 8 packed 16-bit values are xored (a ^= a>>1); the low bit
    // of each feeds the scale ls and the value table selector v_off.
    const uint qs16_off = 16 * ib32;
    uint ls = 0;
    uint a8 = 0;
    [[unroll]] for (uint k = 0; k < 8; ++k) {
        const uint q16 = iqk_load_u16(block_byte + qs16_off + 2 * k);
        uint a = q16 & 0xfffeu;
        a ^= a >> 1;
        if (k == jj / 2) {
            a8 = (a >> (8 * (jj & 1))) & 0xffu;
        }
        ls |= (q16 & 1u) << k;
    }
    const float dl = d * (float(ls & 254u) - 127.0f);
    const uint v_off = (ls & 1u) != 0 ? 16 : 0;

    return float16_t(dl * float(iq4k_values[(lo ? (a8 & 0xFu) : (a8 >> 4)) + v_off]));
}
#endif

