#if defined(GGML_VULKAN_COOPMAT2_DECODE_VECTOR)
// ---------------------------------------------------------------------------
// V=4 vector decode functions. The NV_coopmat2 driver invokes these once per
// group of 4 block-adjacent elements (coordInBlock[1] = the group's lowest
// element index, a multiple of 4) instead of per element, so the row header /
// block selector reads are shared across the group.
// ---------------------------------------------------------------------------
#if defined(DATA_A_IQ2_K)
f16vec4 dequantFuncIQ2_K_v(const in decodeBufQ4_0 bl, const in uint blockCoords[2], const in uint coordInBlock[2])
{
    const uint e0 = coordInBlock[1];
    const uint ib32 = e0 / 32;
    const uint j0 = e0 % 32;
    const uint nbpb = p.K / 256;
    const uint row_bytes = nbpb * 76;
    const uint block_byte = (iqk_cm2_batch_idx() * p.M + blockCoords[0]) * row_bytes + blockCoords[1] * 76;

    const uint extra = iqk_load_u16(block_byte + 2);
    const uint e_shift = extra >> (2 * ib32);
    const uint v1_off = (e_shift & 1u) != 0 ? 4 : 0;
    const uint v2_off = (e_shift & 2u) != 0 ? 4 : 0;
    const float d = iqk_f16_to_f32(iqk_load_u16(block_byte));
    const uint sc = data_a[block_byte + 4 + ib32];
    const bool lo = j0 < 16;
    const float dl = d * (float(lo ? (sc & 0xFu) : (sc >> 4)) - 8.0f);
    const uint v_off = lo ? v1_off : v2_off;

    const u8vec4 qv = unpack8((iqk_load_u32(block_byte + 12 + (ib32 / 4) * 32 + j0) >> (2 * (ib32 % 4))) & 0x03030303u);
    return f16vec4(dl * float(iq2nl_values[qv.x + v_off]), dl * float(iq2nl_values[qv.y + v_off]),
