#if defined(DATA_A_IQ5_K)
#define IQK_BLOCK_BYTES 176
#define IQK_META 0

float16_t dequantFuncIQ5_K(const in decodeBufQ4_0 bl, const in uint blockCoords[2], const in uint coordInBlock[2])
{
    const uint ib64 = coordInBlock[1] / 64;
    const uint part = (coordInBlock[1] % 64) / 32;
    const uint j = coordInBlock[1] % 32;
    const uint nbpb = p.K / 256;
    const uint row_bytes = nbpb * 176;
    const uint block_byte = (iqk_cm2_batch_idx() * p.M + blockCoords[0]) * row_bytes + blockCoords[1] * 176;

    const uint shift = 2 * ib64;
    const uint extra = iqk_load_u16(block_byte + 2);
    const uint e_shift = extra >> (4 * ib64);
    const uint v1_off = (e_shift & (1u << (2 * part))) != 0 ? 32 : 0;
    const uint v2_off = (e_shift & (2u << (2 * part))) != 0 ? 32 : 0;

    const float d = iqk_f16_to_f32(iqk_load_u16(block_byte));
    const uint sh = data_a[block_byte + 4 + ib64];
    const uint sl = data_a[block_byte + 8 + 2 * ib64 + part];
    const uint s = (part == 0)
        ? (j < 16 ? ((sl & 0xFu) | ((sh << 4) & 0x30u)) : ((sl >> 4) | ((sh << 2) & 0x30u)))
        : (j < 16 ? ((sl & 0xFu) | (sh & 0x30u))      : ((sl >> 4) | ((sh >> 2) & 0x30u)));
    const float dl = d * (float(s) - 32.0f);
    const uint v_off = j < 16 ? v1_off : v2_off;

    const uint q = data_a[block_byte + 16 + 32 * ib64 + j];
    const uint hb = data_a[block_byte + 144 + j];
    const uint qv = (part == 0)
        ? ((q & 0xFu) | (((hb >> shift) & 1u) << 4))
        : ((q >> 4) | (((hb >> shift) & 2u) << 3));
    return float16_t(dl * float(iq5nl_values[qv + v_off]));
}
