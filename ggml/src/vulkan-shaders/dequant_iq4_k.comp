#version 450

#include "dequant_head.comp"
#include "iqk_tables.comp"
#include "dequant_iqk_common.comp"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

#define QUANT_K 256
#define BLOCK_BYTES 144

vec4 iq4k_lo(uint w, uint vo) {
    return vec4(
        float(iq4k_values[(w & 0xFu) + vo]),
        float(iq4k_values[((w >> 8) & 0xFu) + vo]),
        float(iq4k_values[((w >> 16) & 0xFu) + vo]),
        float(iq4k_values[((w >> 24) & 0xFu) + vo]));
}

vec4 iq4k_hi(uint w, uint vo) {
    return vec4(
        float(iq4k_values[((w >> 4) & 0xFu) + vo]),
        float(iq4k_values[((w >> 12) & 0xFu) + vo]),
        float(iq4k_values[((w >> 20) & 0xFu) + vo]),
        float(iq4k_values[((w >> 28) & 0xFu) + vo]));
}

void main() {
    const uint ib = gl_WorkGroupID.x * 32 + gl_LocalInvocationID.x / 8;
    const uint ib32 = gl_LocalInvocationID.x % 8;

    if (ib >= p.nel / QUANT_K) {
        return;
    }

    const uint nbpb = p.K;
    const uint meta = p.stride_a;
    const uint row_bytes = meta + nbpb * BLOCK_BYTES;
    const uint block_byte = (ib / nbpb) * row_bytes + meta + (ib % nbpb) * BLOCK_BYTES;

    const uint dw = block_byte / 4;
    const uint head = data_a32[dw];
    const float d = iqk_f16_to_f32(head & 0xffffu);
    const uint extra = head >> 16;
    const uint sh01 = data_a32[dw + 1];
    const uint sc01 = data_a32[dw + 2];
    const uint sc23 = data_a32[dw + 3];
    const uint b_idx = QUANT_K * ib + 32 * ib32;

    const uint shb = (sh01 >> (8 * (ib32 / 2))) & 0xffu;
    const uint sh = shb >> (4 * (ib32 % 2));
    const uint sc = (ib32 < 4 ? sc01 : sc23) >> (8 * (ib32 & 3));
    const float dl1 = d * (float((sc & 0xFu) | ((sh << 4) & 0x30u)) - 32.0f);
    const float dl2 = d * (float(((sc >> 4) & 0xFu) | ((sh << 2) & 0x30u)) - 32.0f);
    const uint e = extra >> (2 * ib32);
    const uint v1_off = (e & 1u) != 0 ? 16u : 0u;
    const uint v2_off = (e & 2u) != 0 ? 16u : 0u;
    const uint qs_dw = (block_byte + 16 + 16 * ib32) / 4;

    [[unroll]] for (uint j = 0; j < 4; ++j) {
        const uint qw = data_a32[qs_dw + j];
        iqk_store4(b_idx + 4 * j,      dl1 * iq4k_lo(qw, v1_off));
        iqk_store4(b_idx + 16 + 4 * j, dl2 * iq4k_hi(qw, v2_off));
    }
}
