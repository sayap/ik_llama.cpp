#version 450

#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

#include "mul_mat_vec_iqk_base.comp"

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

#define QUANT_K 256
#define BLOCK_BYTES 68
#define META 4

FLOAT_TYPE temp[NUM_COLS][NUM_ROWS];

void calc_superblock(const uint a_byte, const uint b_offset, const uint itid, const uint i,
                     const uint num_blocks_per_row, const uint first_row, const uint num_rows) {
    // 16 threads per block: ib32 = itid/2 (0..7), half = itid%2.
    // Each thread handles 16 elements = 2 groups of 8 values.
    const uint ib32 = itid / 2;
    const uint h = itid % 2;
    const uint e = 32 * ib32 + 16 * h;

    const uint y_idx = i * QUANT_K + e;
    const uint row_bytes = p.stride_a + num_blocks_per_row * BLOCK_BYTES;

    [[unroll]] for (uint n = 0; n < num_rows; ++n) {
        const uint row_byte = a_byte + (first_row + n) * row_bytes;
        const uint block_byte = row_byte + META + i * BLOCK_BYTES;

        const float d = uintBitsToFloat(iqk_load_u32(row_byte));
        const uint sc = data_a[block_byte + ib32 % 4] >> (4 * (ib32 / 4));
        const float dl = d * 1.05f * float(iq4k_values[sc & 0xFu]);

        const uint ql_off = 4 + 8 * ib32 + 4 * h;

        [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
            const uint b4 = (j * p.batch_stride_b + b_offset + y_idx) / 4;
            vec4 b0 = vec4(data_b_v4[b4 + 0]);
            vec4 b1 = vec4(data_b_v4[b4 + 1]);
            vec4 b2 = vec4(data_b_v4[b4 + 2]);
            vec4 b3 = vec4(data_b_v4[b4 + 3]);
            FLOAT_TYPE sum = FLOAT_TYPE(0.0f);

            uint x0 = iqk_load_u16(block_byte + ql_off + 0) + 4096u;
            const vec4 v00 = iqk_hash_values(x0, false, 0u);
            const vec4 v01 = iqk_hash_values(x0, false, 0u);

            uint x1 = iqk_load_u16(block_byte + ql_off + 2) + 4096u;
            const vec4 v10 = iqk_hash_values(x1, false, 0u);
            const vec4 v11 = iqk_hash_values(x1, false, 0u);

            sum += FLOAT_TYPE(b0[0]) * FLOAT_TYPE(v00.x);
            sum += FLOAT_TYPE(b0[1]) * FLOAT_TYPE(v00.y);
            sum += FLOAT_TYPE(b0[2]) * FLOAT_TYPE(v00.z);
            sum += FLOAT_TYPE(b0[3]) * FLOAT_TYPE(v00.w);
            sum += FLOAT_TYPE(b1[0]) * FLOAT_TYPE(v01.x);
            sum += FLOAT_TYPE(b1[1]) * FLOAT_TYPE(v01.y);
            sum += FLOAT_TYPE(b1[2]) * FLOAT_TYPE(v01.z);
            sum += FLOAT_TYPE(b1[3]) * FLOAT_TYPE(v01.w);
            sum += FLOAT_TYPE(b2[0]) * FLOAT_TYPE(v10.x);
            sum += FLOAT_TYPE(b2[1]) * FLOAT_TYPE(v10.y);
            sum += FLOAT_TYPE(b2[2]) * FLOAT_TYPE(v10.z);
            sum += FLOAT_TYPE(b2[3]) * FLOAT_TYPE(v10.w);
            sum += FLOAT_TYPE(b3[0]) * FLOAT_TYPE(v11.x);
            sum += FLOAT_TYPE(b3[1]) * FLOAT_TYPE(v11.y);
            sum += FLOAT_TYPE(b3[2]) * FLOAT_TYPE(v11.z);
            sum += FLOAT_TYPE(b3[3]) * FLOAT_TYPE(v11.w);

            temp[j][n] = fma(dl, sum, temp[j][n]);
        }
    }
}

void compute_outputs(const uint32_t first_row, const uint32_t num_rows) {
    uint a_byte, b_offset, d_offset;
    get_offsets(a_byte, b_offset, d_offset);

    const uint num_blocks_per_row = p.ncols / QUANT_K;

    const uint blocks_per_wg = gl_WorkGroupSize.x / 16;
    const uint tid = gl_LocalInvocationID.x;
    const uint itid = tid % 16;
    const uint ix = tid / 16;

    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        [[unroll]] for (uint i = 0; i < NUM_ROWS; ++i) {
            temp[j][i] = FLOAT_TYPE(0);
        }
    }

    [[unroll]] for (uint i = ix; i < num_blocks_per_row; i += blocks_per_wg)
        calc_superblock(a_byte, b_offset, itid, i, num_blocks_per_row, first_row, num_rows);

    reduce_result(temp, d_offset, first_row, num_rows, tid);
}

void main() {
    const uint first_row = NUM_ROWS * (gl_WorkGroupID.x + gl_NumWorkGroups.x * gl_WorkGroupID.z);

    if (first_row + NUM_ROWS <= p.stride_d) {
        compute_outputs(first_row, NUM_ROWS);
    } else {
        if (first_row >= p.stride_d) {
            return;
        }
        compute_outputs(first_row, p.stride_d - first_row);
    }
}
