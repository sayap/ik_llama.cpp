#version 450

#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

#include "mul_mat_vec_iqk_base_q8_1.comp"

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

// uint32 view of the byte-addressed weight buffer (IQ4_KSS has a 4-byte row
// meta header and 128-byte blocks, so every row/block/field offset is 4-byte
// aligned).
layout (binding = 0) readonly buffer A32 { uint data_a32[]; };

#define QUANT_K 256
#define BLOCK_BYTES 128
#define META 4

shared uint iq4k_byte_shmem[2][128];

uint iq4k_byte_entry(uint v, uint q) {
    return iq4k_byte_shmem[v][q / 2u] >> (16u * (q % 2u));
}

FLOAT_TYPE temp[NUM_COLS][NUM_ROWS];

void calc_superblock(const uint a_byte, const uint b_offset, const uint itid, const uint i,
                     const uint num_blocks_per_row, const uint first_row, const uint num_rows) {
    // 8 threads per block: each thread handles one 32-element group of a block.
    const uint ib32 = itid;
    const uint e = 32 * ib32;

    const uint y_idx = i * QUANT_K + e;
    const uint row_bytes = p.stride_a + num_blocks_per_row * BLOCK_BYTES;

    [[unroll]] for (uint n = 0; n < num_rows; ++n) {
        const uint row_byte = a_byte + (first_row + n) * row_bytes;
        const uint block_byte = row_byte + META + i * BLOCK_BYTES;

        const uint row_dw = row_byte >> 2;
        const uint block_dw = (row_byte + META + i * BLOCK_BYTES) >> 2;

        const float d = uintBitsToFloat(data_a32[row_dw]);

        // Decode the 8 packed 16-bit values of this 32-element sub-block into 16
        // nibble-pair bytes. The scale/table-selector bits are the LSBs.
        uint ls = 0;
        uint a8[16];
        const uint qs_dw = block_dw + 4 * ib32;
        [[unroll]] for (uint m = 0; m < 4; ++m) {
            const uint w = data_a32[qs_dw + m];
            [[unroll]] for (uint h = 0; h < 2; ++h) {
                const uint q16 = (w >> (16 * h)) & 0xffffu;
                uint a = q16 & 0xfffeu;
                a ^= a >> 1;
                a8[4 * m + 2 * h + 0] = a & 0xffu;
                a8[4 * m + 2 * h + 1] = (a >> 8) & 0xffu;
                ls |= (q16 & 1u) << (2 * m + h);
            }
        }
        const float dl = d * (float(ls & 254u) - 127.0f);
        const uint v_sel = (ls & 1u) != 0 ? 1 : 0;

        [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
            const uint b8 = (j * p.batch_stride_b + b_offset + y_idx) / 32;
            const vec2 ds = vec2(data_b[b8].ds);
            const float d8 = ds.x;

            int sumi = 0;
            [[unroll]] for (uint g = 0; g < 4; ++g) {
                int packed_lo = 0;
                int packed_hi = 0;
                [[unroll]] for (uint k = 0; k < 4; ++k) {
                    const uint q = a8[4 * g + k];
                    const uint entry = iq4k_byte_entry(v_sel, q);
                    packed_lo |= int(entry & 0xffu) << (8 * k);
                    packed_hi |= int((entry >> 8) & 0xffu) << (8 * k);
                }
                sumi += dotPacked4x8EXT(packed_lo, data_b[b8].qs[g]);
                sumi += dotPacked4x8EXT(packed_hi, data_b[b8].qs[g + 4]);
            }

            temp[j][n] = fma(dl * d8, float(sumi), temp[j][n]);
        }
    }
}

void compute_outputs(const uint32_t first_row, const uint32_t num_rows) {
    uint a_byte, b_offset, d_offset;
    get_offsets(a_byte, b_offset, d_offset);

    const uint num_blocks_per_row = p.ncols / QUANT_K;

    const uint blocks_per_wg = gl_WorkGroupSize.x / 8;
    const uint tid = gl_LocalInvocationID.x;
    const uint itid = tid % 8;
    const uint ix = tid / 8;

    [[unroll]] for (uint idx = tid; idx < 128; idx += BLOCK_SIZE) {
        iq4k_byte_shmem[0][idx] = iq4k_values_byte_0[idx];
        iq4k_byte_shmem[1][idx] = iq4k_values_byte_16[idx];
    }
    barrier();

    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        [[unroll]] for (uint i = 0; i < NUM_ROWS; ++i) {
            temp[j][i] = FLOAT_TYPE(0);
        }
    }

    [[unroll]] for (uint i = ix; i < num_blocks_per_row; i += blocks_per_wg)
        calc_superblock(a_byte, b_offset, itid, i, num_blocks_per_row, first_row, num_rows);

    reduce_result(temp, d_offset, first_row, num_rows, tid);
}

void main() {
    const uint first_row = NUM_ROWS * (gl_WorkGroupID.x + gl_NumWorkGroups.x * gl_WorkGroupID.z);

    if (first_row + NUM_ROWS <= p.stride_d) {
        compute_outputs(first_row, NUM_ROWS);
    } else {
        if (first_row >= p.stride_d) {
            return;
        }
        compute_outputs(first_row, p.stride_d - first_row);
    }
}
