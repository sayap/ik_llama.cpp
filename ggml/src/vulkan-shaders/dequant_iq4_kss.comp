#version 450

#include "dequant_head.comp"
#include "iqk_tables.comp"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout (binding = 1) writeonly buffer D {D_TYPE data_b[];};

#define QUANT_K 256
#define BLOCK_BYTES 128
#define META 4

void main() {
    const uint ib = gl_WorkGroupID.x * 32 + gl_LocalInvocationID.x / 8;
    const uint ib32 = gl_LocalInvocationID.x % 8;

    if (ib >= p.nel / QUANT_K) {
        return;
    }

    const uint nbpb = p.K;
    const uint meta = p.stride_a;
    const uint row_bytes = meta + nbpb * BLOCK_BYTES;
    const uint block_byte = (ib / nbpb) * row_bytes + META + (ib % nbpb) * BLOCK_BYTES;

    const float d = uintBitsToFloat(iqk_load_u32(row_bytes * (ib / nbpb)));

    // Decode the 8 packed 16-bit values of this 32-element sub-block
    uint ls = 0;
    uint aux16[8];
    const uint qs16_off = 16 * ib32;
    [[unroll]] for (uint k = 0; k < 8; ++k) {
        const uint q16 = iqk_load_u16(block_byte + qs16_off + 2 * k);
        uint a = q16 & 0xfffeu;
        a ^= a >> 1;
        aux16[k] = a;
        ls |= (q16 & 1u) << k;
    }
    const float dl = d * (float(ls & 254u) - 127.0f);
    const uint v_off = (ls & 1u) != 0 ? 16 : 0;

    const uint b_idx = QUANT_K * ib + 32 * ib32;
    [[unroll]] for (uint j = 0; j < 16; ++j) {
        const uint a8 = (aux16[j / 2] >> (8 * (j & 1))) & 0xffu;
        data_b[b_idx + j]      = D_TYPE(dl * float(iq4k_values[(a8 & 0xFu) + v_off]));
        data_b[b_idx + j + 16] = D_TYPE(dl * float(iq4k_values[(a8 >> 4) + v_off]));
    }
}
