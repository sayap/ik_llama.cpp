#version 450

#include "dequant_head.comp"
#include "iqk_tables.comp"
#include "dequant_iqk_common.comp"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

#define QUANT_K 256
#define BLOCK_BYTES 128
#define META 4

void main() {
    const uint ib = gl_WorkGroupID.x * 32 + gl_LocalInvocationID.x / 8;
    const uint ib32 = gl_LocalInvocationID.x % 8;

    if (ib >= p.nel / QUANT_K) {
        return;
    }

    const uint nbpb = p.K;
    const uint meta = p.stride_a;
    const uint row_bytes = meta + nbpb * BLOCK_BYTES;
    const uint row = ib / nbpb;
    const uint block_byte = row * row_bytes + META + (ib % nbpb) * BLOCK_BYTES;

    const float d = uintBitsToFloat(data_a32[(row * row_bytes) / 4]);
    const uint b_idx = QUANT_K * ib + 32 * ib32;
    const uint qs_dw = (block_byte + 16 * ib32) / 4;

    uint a[8];
    uint ls = 0u;
    [[unroll]] for (uint k = 0; k < 4; ++k) {
        const uint w = data_a32[qs_dw + k];
        const uint qlo = w & 0xffffu;
        const uint qhi = w >> 16;
        uint a0 = qlo & 0xfffeu;
        a0 ^= a0 >> 1;
        uint a1 = qhi & 0xfffeu;
        a1 ^= a1 >> 1;
        a[2 * k] = a0;
        a[2 * k + 1] = a1;
        ls |= (qlo & 1u) << (2 * k);
        ls |= (qhi & 1u) << (2 * k + 1);
    }

    const float dl = d * (float(ls & 254u) - 127.0f);
    const uint v_off = (ls & 1u) != 0 ? 16u : 0u;

    [[unroll]] for (uint t = 0; t < 4; ++t) {
        const uint b0 = a[2 * t] & 0xffu;
        const uint b1 = (a[2 * t] >> 8) & 0xffu;
        const uint b2 = a[2 * t + 1] & 0xffu;
        const uint b3 = (a[2 * t + 1] >> 8) & 0xffu;
        iqk_store4(b_idx + 4 * t, dl * vec4(
            float(iq4k_values[(b0 & 0xFu) + v_off]),
            float(iq4k_values[(b1 & 0xFu) + v_off]),
            float(iq4k_values[(b2 & 0xFu) + v_off]),
            float(iq4k_values[(b3 & 0xFu) + v_off])));
        iqk_store4(b_idx + 16 + 4 * t, dl * vec4(
            float(iq4k_values[((b0 >> 4) & 0xFu) + v_off]),
            float(iq4k_values[((b1 >> 4) & 0xFu) + v_off]),
            float(iq4k_values[((b2 >> 4) & 0xFu) + v_off]),
            float(iq4k_values[((b3 >> 4) & 0xFu) + v_off])));
    }
}
